<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArenaVirtual.Views.Components"
    xmlns:model="clr-namespace:ArenaVirtual.Models"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels"
    x:Name="HomePageRef"
    Title="Início"
    x:DataType="vm:HomeViewModel">

    <Grid RowDefinitions="Auto, *">
        <Grid RowDefinitions="Auto, *">

            <Grid
                Grid.Row="0"
                Padding="20"
                ColumnDefinitions="Auto, *">

                <ImageButton
                    Grid.Column="0"
                    Margin="0,0,0,0"
                    Aspect="AspectFit"
                    BackgroundColor="Transparent"
                    Command="{Binding ToggleThemeCommand}"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    WidthRequest="40">

                    <ImageButton.Triggers>
                        <DataTrigger
                            Binding="{Binding IsDarkMode}"
                            TargetType="ImageButton"
                            Value="True">
                            <Setter Property="Source" Value="sun_icon.png" />
                        </DataTrigger>

                        <DataTrigger
                            Binding="{Binding IsDarkMode}"
                            TargetType="ImageButton"
                            Value="False">
                            <Setter Property="Source" Value="moon_icon.png" />
                        </DataTrigger>
                    </ImageButton.Triggers>
                </ImageButton>

                <HorizontalStackLayout
                    Grid.Column="1"
                    HorizontalOptions="End"
                    Spacing="10">

                    <Label
                        FontSize="16"
                        Text="Status:"
                        VerticalOptions="Center" />

                    <Ellipse
                        HeightRequest="15"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        WidthRequest="15">
                        <Ellipse.Fill>
                            <SolidColorBrush>
                                <SolidColorBrush.Color>
                                    <OnPlatform x:TypeArguments="Color">
                                        <On Platform="iOS, Android" Value="Gray" />
                                        <On Platform="WinUI" Value="Black" />
                                    </OnPlatform>
                                </SolidColorBrush.Color>
                            </SolidColorBrush>
                        </Ellipse.Fill>
                        <Ellipse.Triggers>
                            <DataTrigger
                                Binding="{Binding IsOnline}"
                                TargetType="Ellipse"
                                Value="True">
                                <Setter Property="Fill" Value="Green" />
                            </DataTrigger>
                            <DataTrigger
                                Binding="{Binding IsOnline}"
                                TargetType="Ellipse"
                                Value="False">
                                <Setter Property="Fill" Value="Red" />
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <ImageButton
                        Margin="10,0,0,0"
                        Aspect="AspectFit"
                        BackgroundColor="Transparent"
                        Command="{Binding SincronizarCommand}"
                        HeightRequest="40"
                        HorizontalOptions="End"
                        IsVisible="{Binding IsOnline}"
                        Source="sync_icon.png"
                        WidthRequest="40" />

                </HorizontalStackLayout>

            </Grid>

        </Grid>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="20" Spacing="24">

                <Label
                    FontAttributes="Bold"
                    FontSize="28"
                    HorizontalOptions="Center"
                    Text="Campeonatos"
                    TextColor="OrangeRed" />

                <StackLayout>
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Favoritos"
                        TextColor="OrangeRed" />
                    <CollectionView ItemsSource="{Binding Favoritos}">
                        <CollectionView.EmptyView>
                            <Label
                                HorizontalOptions="Center"
                                Style="{StaticResource ContentTextStyle}"
                                Text="Nenhum campeonato favoritado."
                                VerticalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:Campeonato">
                                <local:CampeonatoCard
                                    CampeonatoItem="{Binding .}"
                                    FavoritarCommand="{Binding BindingContext.FavoritarCommand, Source={x:Reference HomePageRef}}"
                                    VerCampeonatoCommand="{Binding BindingContext.VerCampeonatoCommand, Source={x:Reference HomePageRef}}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <StackLayout>
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Todos os Campeonatos"
                        TextColor="OrangeRed" />
                    <CollectionView ItemsSource="{Binding Campeonatos}">
                        <CollectionView.EmptyView>
                            <Label
                                HorizontalOptions="Center"
                                Style="{StaticResource ContentTextStyle}"
                                Text="Nenhum campeonato encontrado."
                                VerticalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:Campeonato">
                                <local:CampeonatoCard
                                    CampeonatoItem="{Binding .}"
                                    FavoritarCommand="{Binding BindingContext.FavoritarCommand, Source={x:Reference HomePageRef}}"
                                    VerCampeonatoCommand="{Binding BindingContext.VerCampeonatoCommand, Source={x:Reference HomePageRef}}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </StackLayout>
        </ScrollView>

        <Grid
            Grid.RowSpan="2"
            BackgroundColor="#000000"
            IsVisible="{Binding IsBusy}"
            Opacity="0.5">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                VerticalOptions="Center"
                Color="OrangeRed" />
        </Grid>
    </Grid>
</ContentPage>