<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArenaVirtual.Views.Components"
    xmlns:model="clr-namespace:ArenaVirtual.Models"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels"
    x:Name="HomePageRef"
    x:DataType="vm:HomeViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollView Grid.Row="0">
            <StackLayout Padding="20" Spacing="24">

                <Label
                    FontAttributes="Bold"
                    FontSize="28"
                    HorizontalOptions="Center"
                    Text="Campeonatos"
                    TextColor="OrangeRed" />

                <StackLayout>
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Favoritos"
                        TextColor="OrangeRed" />
                    <CollectionView ItemsSource="{Binding Favoritos}">
                        <CollectionView.EmptyView>
                            <Label
                                HorizontalOptions="Center"
                                Text="Nenhum campeonato favoritado."
                                TextColor="White"
                                VerticalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:Campeonato">
                                <local:CampeonatoCard
                                    CampeonatoItem="{Binding .}"
                                    FavoritarCommand="{Binding BindingContext.FavoritarCommand, Source={x:Reference HomePageRef}}"
                                    VerCampeonatoCommand="{Binding BindingContext.VerCampeonatoCommand, Source={x:Reference HomePageRef}}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <StackLayout>
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Todos os Campeonatos"
                        TextColor="OrangeRed" />
                    <CollectionView ItemsSource="{Binding Campeonatos}">
                        <CollectionView.EmptyView>
                            <Label
                                HorizontalOptions="Center"
                                Text="Nenhum campeonato encontrado."
                                TextColor="White"
                                VerticalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:Campeonato">
                                <local:CampeonatoCard
                                    CampeonatoItem="{Binding .}"
                                    FavoritarCommand="{Binding BindingContext.FavoritarCommand, Source={x:Reference HomePageRef}}"
                                    VerCampeonatoCommand="{Binding BindingContext.VerCampeonatoCommand, Source={x:Reference HomePageRef}}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </StackLayout>
        </ScrollView>

        <ImageButton
            Grid.Row="0"
            Margin="0,20,20,0"
            Aspect="AspectFit"
            BackgroundColor="Transparent"
            Command="{Binding SincronizarCommand}"
            HeightRequest="40"
            HorizontalOptions="End"
            IsVisible="{Binding IsOnline}"
            Source="sync_icon.png"
            VerticalOptions="Start"
            WidthRequest="40" />

        <Grid
            Grid.Row="0"
            BackgroundColor="#000000"
            HorizontalOptions="FillAndExpand"
            InputTransparent="True"
            IsVisible="{Binding IsBusy}"
            Opacity="0.5"
            VerticalOptions="FillAndExpand">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Scale="2"
                VerticalOptions="Center"
                Color="OrangeRed" />
        </Grid>
    </Grid>
</ContentPage>