<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.Atleta.EditarTimePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels.Atleta"
    Title="Editar Time"
    x:DataType="vm:EditarTimePageViewModel"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5,
                                      Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=White,
                                                  Dark=#1E1E1E}"
                CornerRadius="20"
                HasShadow="True">
                <Grid
                    ColumnDefinitions="*, Auto"
                    ColumnSpacing="10"
                    VerticalOptions="Center">
                    <Image
                        Grid.Column="0"
                        Aspect="AspectFill"
                        HeightRequest="100"
                        HorizontalOptions="Center"
                        Source="{Binding LogoImageSource}"
                        WidthRequest="100" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding UploadLogoCommand}"
                        Style="{StaticResource BotaoPrincipal}"
                        Text="Trocar Logo" />
                </Grid>
            </Frame>

            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="Nome do Time"
                TextColor="OrangeRed" />
            <Entry
                Placeholder="Insira o nome do time"
                Style="{StaticResource ContentTextStyle}"
                Text="{Binding NomeTime}" />

            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="Descrição"
                TextColor="OrangeRed" />
            <Entry
                Placeholder="Insira uma breve descrição"
                Style="{StaticResource ContentTextStyle}"
                Text="{Binding DescricaoTime}" />

            <Button
                BackgroundColor="#4CAF50"
                Command="{Binding SalvarAlteracoesCommand}"
                IsEnabled="{Binding !IsBusy}"
                Style="{StaticResource BotaoPrincipal}"
                Text="Salvar Alterações"
                TextColor="White" />

            <Button
                BackgroundColor="#F44336"
                Command="{Binding ExcluirTimeCommand}"
                IsEnabled="{Binding !IsBusy}"
                Style="{StaticResource BotaoPrincipal}"
                Text="Excluir Time"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>