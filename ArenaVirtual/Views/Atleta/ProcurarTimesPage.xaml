<ContentPage
    x:Class="ArenaVirtual.Views.Atleta.ProcurarTimesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:ArenaVirtual.ViewModels.Atleta"
    x:Name="thisPage"
    Title="Procurar Times"
    x:DataType="viewmodels:ProcurarTimesPageViewModel">

    <CollectionView ItemsSource="{Binding Times}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="10" Padding="12">
                    <VerticalStackLayout>
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="{Binding Nome}" />
                        <Label FontSize="14" Text="{Binding Descricao}" />
                        <Button
                            Command="{Binding Path=BindingContext.EntrarNoTimeCommand, Source={x:Reference thisPage}}"
                            CommandParameter="{Binding .}"
                            Text="Entrar no Time" />
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>