<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.Atleta.EntrarTimePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels.Atleta"
    Title="Entrar em um Time"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5,
                                      Dark=#121212}">

    <VerticalStackLayout Padding="20" Spacing="20">

        <SearchBar
            Placeholder="Pesquisar times..."
            SearchCommand="{Binding PesquisarCommand}"
            SearchCommandParameter="{Binding Text, Source={RelativeSource Self}}" />

        <CollectionView ItemsSource="{Binding TimesDisponiveis}">
            <CollectionView.EmptyView>
                <Label
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="Nenhum time encontrado."
                    VerticalOptions="CenterAndExpand" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Margin="0,5"
                        Padding="10"
                        BackgroundColor="{AppThemeBinding Light=White,
                                                          Dark=#1E1E1E}"
                        CornerRadius="10">
                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                Aspect="AspectFill"
                                HeightRequest="50"
                                Source="{Binding LogoUrl}"
                                VerticalOptions="Start"
                                WidthRequest="50" />

                            <VerticalStackLayout
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="15,0,0,0"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="Start">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding Nome}"
                                    TextColor="OrangeRed" />
                                <Label
                                    FontSize="12"
                                    Text="{Binding Descricao}"
                                    TextColor="Gray" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                BackgroundColor="{Binding ButtonColor}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EntrarTimePageViewModel}}, Path=SolicitarEntradaCommand}"
                                CommandParameter="{Binding .}"
                                IsEnabled="{Binding IsButtonEnabled}"
                                Style="{StaticResource BotaoPrincipal}"
                                Text="{Binding ButtonText}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>