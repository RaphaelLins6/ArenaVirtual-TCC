<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.Atleta.PartidasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:ArenaVirtual.Models"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels.Atleta"
    Title="Jogos"
    x:DataType="vm:PartidasViewModel"
    Shell.NavBarIsVisible="True">

    <StackLayout Padding="20">
        <Label
            Margin="0,0,0,15"
            FontAttributes="Bold"
            FontSize="24"
            Text="{Binding NomeTime, StringFormat='Próximas Partidas de {0}'}" />

        <CollectionView
            EmptyView="Nenhuma partida agendada ou em andamento encontrada para este time."
            ItemsSource="{Binding PartidasDoTime}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Jogo">
                    <Frame
                        Margin="0,5"
                        Padding="10"
                        CornerRadius="8"
                        HasShadow="True">
                        <StackLayout>

                            <Label
                                Margin="0,0,0,5"
                                FontAttributes="Italic"
                                FontSize="Small"
                                HorizontalOptions="Center"
                                Text="{Binding NomeCampeonato}"
                                TextColor="#FF9800" />

                            <Grid Padding="5" ColumnDefinitions="*,Auto,*">

                                <StackLayout Grid.Column="0" HorizontalOptions="Start">
                                    <Image
                                        HeightRequest="40"
                                        HorizontalOptions="Center"
                                        Source="{Binding TimeA.LogoUrl}"
                                        WidthRequest="40" />
                                    <Label
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        Text="{Binding TimeA.Nome}" />
                                </StackLayout>

                                <StackLayout
                                    Grid.Column="1"
                                    HorizontalOptions="Center"
                                    Spacing="2">
                                    <Label
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding DataHora, StringFormat='{0:dd/MM - HH:mm}'}" />
                                    <Label
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding Local}" />
                                    <Label
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        Text="VS" />
                                    <Label
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding Rodada, StringFormat='Rodada {0}'}" />
                                </StackLayout>

                                <StackLayout Grid.Column="2" HorizontalOptions="End">
                                    <Image
                                        HeightRequest="40"
                                        HorizontalOptions="Center"
                                        Source="{Binding TimeB.LogoUrl}"
                                        WidthRequest="40" />
                                    <Label
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        Text="{Binding TimeB.Nome}" />
                                </StackLayout>

                            </Grid>

                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>