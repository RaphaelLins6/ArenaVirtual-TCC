<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.Patrocinador.DashboardPatrocinadorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels.Patrocinador"
    Title="Dashboard"
    x:DataType="vm:DashboardPatrocinadorViewModel"
    Shell.NavBarIsVisible="True">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding LoadCampanhasCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="20">

                <StackLayout
                    Margin="0,0,0,15"
                    Orientation="Horizontal"
                    Spacing="10">

                    <Button
                        BackgroundColor="#FF9800"
                        Command="{Binding NavegarParaBuscaCampeonatosCommand}"
                        HorizontalOptions="FillAndExpand"
                        Style="{StaticResource BotaoPrincipal}"
                        Text="Buscar Campeonatos"
                        TextColor="Black" />

                </StackLayout>

                <Label
                    Margin="0,0,0,15"
                    FontAttributes="Bold"
                    FontSize="24"
                    Text="Minhas Campanhas Ativas"
                    TextColor="#FFA500" />

                <RefreshView Command="{Binding LoadCampanhasCommand}" IsRefreshing="{Binding EstaOcupado}">

                    <CollectionView ItemsSource="{Binding CampanhasAtivas}" SelectionMode="None">

                        <CollectionView.EmptyView>
                            <StackLayout Padding="20">
                                <Label
                                    HorizontalOptions="Center"
                                    Text="Você não tem campanhas de patrocínio ativas."
                                    TextColor="Orange"
                                    VerticalOptions="Center" />
                            </StackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CampanhaAtivaViewModel">
                                <Frame
                                    Margin="0,5"
                                    Padding="10"
                                    BackgroundColor="#1E1E1E"
                                    CornerRadius="8"
                                    HasShadow="True">
                                    <StackLayout>

                                        <Label
                                            Margin="0,0,0,5"
                                            FontAttributes="Bold"
                                            FontSize="Medium"
                                            HorizontalOptions="Center"
                                            Text="{Binding NomeCampanha}"
                                            TextColor="White" />

                                        <Grid Padding="5" ColumnDefinitions="Auto,*,Auto">

                                            <Image
                                                Grid.Column="0"
                                                Margin="0,0,15,0"
                                                HeightRequest="40"
                                                HorizontalOptions="Start"
                                                Source="{Binding LogotipoCampeonatoUrl}"
                                                WidthRequest="40" />

                                            <StackLayout
                                                Grid.Column="1"
                                                HorizontalOptions="Start"
                                                Spacing="2">
                                                <Label
                                                    FontAttributes="Italic"
                                                    FontSize="Small"
                                                    Text="{Binding NomeCampeonato}"
                                                    TextColor="#FF9800" />
                                                <Label
                                                    FontSize="Small"
                                                    Text="{Binding Status, StringFormat='Status: {0}'}"
                                                    TextColor="White" />
                                            </StackLayout>

                                            <StackLayout Grid.Column="2" HorizontalOptions="End">
                                                <Label
                                                    FontAttributes="Bold"
                                                    HorizontalTextAlignment="End"
                                                    Text="{Binding DataFim, StringFormat='Término: {0}'}"
                                                    TextColor="LightGray" />
                                                <Button
                                                    BackgroundColor="#2ECC71"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardPatrocinadorViewModel}}, Path=NavegarParaDetalhesCampanhaCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="Small"
                                                    HeightRequest="35"
                                                    Style="{StaticResource BotaoPrincipal}"
                                                    Text="Ver Detalhes"
                                                    TextColor="White" />
                                            </StackLayout>

                                        </Grid>
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>