<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.Arbitro.DashboardArbitroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArenaVirtual.Views.Arbitro"
    xmlns:models="clr-namespace:ArenaVirtual.Models.ViewModels.Shared"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels.Arbitro"
    Title="Dashboard"
    x:DataType="vm:DashboardArbitroViewModel"
    Shell.NavBarIsVisible="True">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding LoadPartidasCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <StackLayout Padding="20">

            <Button
                Margin="0,0,0,15"
                BackgroundColor="#007ACC"
                Command="{Binding NavigateToInscricoesCommand}"
                Style="{StaticResource BotaoPrincipal}"
                Text="Inscrição"
                TextColor="White" />

            <Label
                Margin="0,0,0,15"
                FontAttributes="Bold"
                FontSize="24"
                Text="Minhas Partidas Designadas"
                TextColor="#FFA500" />

            <RefreshView Command="{Binding LoadPartidasCommand}" IsRefreshing="{Binding EstaOcupado}">

                <CollectionView ItemsSource="{Binding MinhasPartidas}" SelectionMode="None">

                    <CollectionView.EmptyView>
                        <StackLayout Padding="20">
                            <Label
                                HorizontalOptions="Center"
                                Text="Você não tem partidas designadas."
                                TextColor="Orange"
                                VerticalOptions="Center" />
                        </StackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:JogoDetalheViewModel">
                            <Frame
                                Margin="0,5"
                                Padding="10"
                                BackgroundColor="#1E1E1E"
                                CornerRadius="8"
                                HasShadow="True">
                                <StackLayout>

                                    <Label
                                        Margin="0,0,0,5"
                                        FontAttributes="Italic"
                                        FontSize="Small"
                                        HorizontalOptions="Center"
                                        Text="{Binding NomeCampeonato}"
                                        TextColor="#FF9800" />

                                    <Grid Padding="5" ColumnDefinitions="*,Auto,*">

                                        <StackLayout Grid.Column="0" HorizontalOptions="Start">
                                            <Image
                                                HeightRequest="40"
                                                HorizontalOptions="Center"
                                                Source="{Binding Jogo.TimeA.LogoUrl}"
                                                WidthRequest="40" />
                                            <Label
                                                FontAttributes="Bold"
                                                HorizontalOptions="Center"
                                                Text="{Binding NomeTimeA}" />
                                        </StackLayout>

                                        <StackLayout
                                            Grid.Column="1"
                                            HorizontalOptions="Center"
                                            Spacing="2">
                                            <Label
                                                FontSize="12"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding DataHora, StringFormat='{0:dd/MM - HH:mm}'}" />
                                            <Label
                                                FontSize="12"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding Jogo.Local}" />
                                            <Label
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                Text="VS" />
                                            <Label
                                                FontSize="12"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding Jogo.Rodada, StringFormat='Rodada {0}'}" />
                                        </StackLayout>

                                        <StackLayout Grid.Column="2" HorizontalOptions="End">
                                            <Image
                                                HeightRequest="40"
                                                HorizontalOptions="Center"
                                                Source="{Binding Jogo.TimeB.LogoUrl}"
                                                WidthRequest="40" />
                                            <Label
                                                FontAttributes="Bold"
                                                HorizontalOptions="Center"
                                                Text="{Binding NomeTimeB}" />
                                        </StackLayout>

                                    </Grid>

                                    <Button
                                        Margin="0,10,0,0"
                                        BackgroundColor="#FFA500"
                                        Clicked="OnLancarEstatisticasClicked"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding PodeLancarEstatisticas}"
                                        Style="{StaticResource BotaoPrincipal}"
                                        Text="Lançar Estatísticas"
                                        TextColor="Black" />

                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>