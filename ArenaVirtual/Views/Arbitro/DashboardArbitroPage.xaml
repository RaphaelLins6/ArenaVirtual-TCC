<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.Arbitro.DashboardArbitroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ArenaVirtual.Models.ViewModels.Shared"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels.Arbitro"
    Title="Dashboard"
    x:DataType="vm:DashboardArbitroViewModel"
    Shell.NavBarIsVisible="True">

    <ContentPage.Content>
        <Grid Padding="20" RowDefinitions="Auto, Auto, *, Auto, *">

            <Button
                Grid.Row="0"
                Margin="0,0,0,15"
                BackgroundColor="#007ACC"
                Command="{Binding NavigateToInscricoesCommand}"
                Style="{StaticResource BotaoPrincipal}"
                Text="Inscrição"
                TextColor="White" />

            <Label
                Grid.Row="1"
                Margin="0,0,0,10"
                FontAttributes="Bold"
                FontSize="24"
                Text="Partidas para Lançamento"
                TextColor="#FFA500" />

            <RefreshView
                Grid.Row="2"
                Command="{Binding LoadPartidasCommand}"
                IsRefreshing="{Binding EstaOcupado}">

                <CollectionView ItemsSource="{Binding JogosParaLancamento}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <StackLayout Padding="20">
                            <Label
                                HorizontalOptions="Center"
                                Text="Você não tem partidas pendentes."
                                TextColor="Orange"
                                VerticalOptions="Center" />
                        </StackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:JogoDetalheViewModel">
                            <Frame
                                Margin="0,5"
                                Padding="10"
                                BackgroundColor="#1E1E1E"
                                CornerRadius="8"
                                HasShadow="True">
                                <StackLayout>

                                    <Label
                                        Margin="0,0,0,5"
                                        FontAttributes="Italic"
                                        FontSize="Small"
                                        HorizontalOptions="Center"
                                        Text="{Binding NomeCampeonato}"
                                        TextColor="#FF9800" />

                                    <Grid Padding="5" ColumnDefinitions="*,Auto,*">
                                        <StackLayout Grid.Column="0" HorizontalOptions="Start">
                                            <Image
                                                HeightRequest="40"
                                                HorizontalOptions="Center"
                                                Source="{Binding Jogo.TimeA.LogoUrl}"
                                                WidthRequest="40" />
                                            <Label
                                                FontAttributes="Bold"
                                                HorizontalOptions="Center"
                                                Text="{Binding NomeTimeA}" />
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Column="1"
                                            HorizontalOptions="Center"
                                            Spacing="2">
                                            <Label
                                                FontSize="12"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding DataHora, StringFormat='{0:dd/MM - HH:mm}'}" />
                                            <Label
                                                FontSize="12"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding Jogo.Local}" />
                                            <Label
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                Text="VS" />
                                            <Label
                                                FontSize="12"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding Jogo.Rodada, StringFormat='Rodada {0}'}" />
                                        </StackLayout>
                                        <StackLayout Grid.Column="2" HorizontalOptions="End">
                                            <Image
                                                HeightRequest="40"
                                                HorizontalOptions="Center"
                                                Source="{Binding Jogo.TimeB.LogoUrl}"
                                                WidthRequest="40" />
                                            <Label
                                                FontAttributes="Bold"
                                                HorizontalOptions="Center"
                                                Text="{Binding NomeTimeB}" />
                                        </StackLayout>
                                    </Grid>

                                    <Button
                                        Margin="0,10,0,0"
                                        BackgroundColor="#FFA500"
                                        Clicked="OnLancarEstatisticasClicked"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding PodeLancarEstatisticas}"
                                        Style="{StaticResource BotaoPrincipal}"
                                        Text="Lançar Estatísticas"
                                        TextColor="Black" />
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <Label
                Grid.Row="3"
                Margin="0,20,0,10"
                FontAttributes="Bold"
                FontSize="20"
                IsVisible="{Binding IsJogosLancadosVisivel}"
                Text="Partidas Lançadas Recentemente"
                TextColor="#3CB371" />

            <CollectionView
                Grid.Row="4"
                ItemsSource="{Binding JogosLancados}"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:JogoDetalheViewModel">
                        <Frame
                            Margin="0,5"
                            Padding="10"
                            BackgroundColor="#1E1E1E"
                            CornerRadius="8"
                            HasShadow="True">
                            <StackLayout>
                                <Label
                                    Margin="0,0,0,5"
                                    FontAttributes="Italic"
                                    FontSize="Small"
                                    HorizontalOptions="Center"
                                    Text="{Binding NomeCampeonato}"
                                    TextColor="#FF9800" />
                                <Grid Padding="5" ColumnDefinitions="*,Auto,*">
                                    <StackLayout Grid.Column="0" HorizontalOptions="Start">
                                        <Image
                                            HeightRequest="40"
                                            HorizontalOptions="Center"
                                            Source="{Binding Jogo.TimeA.LogoUrl}"
                                            WidthRequest="40" />
                                        <Label
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center"
                                            Text="{Binding NomeTimeA}" />
                                    </StackLayout>
                                    <StackLayout
                                        Grid.Column="1"
                                        HorizontalOptions="Center"
                                        Spacing="2">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            HorizontalTextAlignment="Center"
                                            Text="ESTATÍSTICAS LANÇADAS"
                                            TextColor="#3CB371" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding PlacarFinal}" />
                                        <Label
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding DataHora, StringFormat='{0:dd/MM - HH:mm}'}" />
                                    </StackLayout>
                                    <StackLayout Grid.Column="2" HorizontalOptions="End">
                                        <Image
                                            HeightRequest="40"
                                            HorizontalOptions="Center"
                                            Source="{Binding Jogo.TimeB.LogoUrl}"
                                            WidthRequest="40" />
                                        <Label
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center"
                                            Text="{Binding NomeTimeB}" />
                                    </StackLayout>
                                </Grid>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </ContentPage.Content>
</ContentPage>