<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.Arbitro.CampeonatoInscricao"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArenaVirtual.Converters"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels.Arbitro"
    Title="Solicitar Arbitragem"
    x:DataType="vm:CampeonatoInscricaoViewModel"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5,
                                      Dark=#121212}">

    <ContentPage.Resources>
        <local:InverterBooleanConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20" Spacing="20">

        <SearchBar
            Placeholder="Pesquisar campeonatos..."
            SearchCommand="{Binding CarregarCampeonatosCommand}"
            SearchCommandParameter="{Binding Text, Source={RelativeSource Self}}" />

        <ActivityIndicator
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="#FF4500" />

        <CollectionView
            IsVisible="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
            ItemsSource="{Binding CampeonatosDisponiveis}"
            VerticalOptions="FillAndExpand">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="40"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand">
                    <Label
                        FontSize="16"
                        HorizontalOptions="Center"
                        Text="Nenhum campeonato encontrado."
                        TextColor="Gray" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CampeonatoItemViewModel">
                    <Frame
                        Margin="0,5"
                        Padding="10"
                        BackgroundColor="{AppThemeBinding Light=White,
                                                          Dark=#1E1E1E}"
                        CornerRadius="10">
                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">

                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                Aspect="AspectFill"
                                HeightRequest="50"
                                Source="{Binding LogoUrl}"
                                VerticalOptions="Start"
                                WidthRequest="50" />

                            <VerticalStackLayout
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="15,0,0,0"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="Start">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding Nome}" />
                                <Label
                                    FontSize="12"
                                    Text="{Binding Descricao}"
                                    TextColor="Gray" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                BackgroundColor="{Binding ButtonColor}"
                                Clicked="OnSolicitarArbitragemClicked"
                                IsEnabled="{Binding IsButtonEnabled}"
                                Style="{StaticResource BotaoPrincipal}"
                                Text="{Binding ButtonText}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </VerticalStackLayout>
</ContentPage>