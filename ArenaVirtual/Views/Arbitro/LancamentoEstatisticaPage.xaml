                                            Text="{Binding Bloqueios}" />
                                        <Entry
                                            Grid.Column="7"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                              Dark=#282828}"
                                            FontSize="14"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            Style="{StaticResource ContentTextStyle}"
                                            Text="{Binding Turnovers}" />

                                        <Entry
                                            Grid.Column="8"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                              Dark=#282828}"
                                            FontSize="14"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            Style="{StaticResource ContentTextStyle}"
                                            Text="{Binding Faltas}" />
                                        <Entry
                                            Grid.Column="9"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                              Dark=#282828}"
                                            FontSize="14"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            Style="{StaticResource ContentTextStyle}"
                                            Text="{Binding Arremessos2PontosConvertidos}" />
                                        <Entry
                                            Grid.Column="10"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                              Dark=#282828}"
                                            FontSize="14"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            Style="{StaticResource ContentTextStyle}"
                                            Text="{Binding Arremessos2PontosTentados}" />
                                        <Entry
                                            Grid.Column="11"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                              Dark=#282828}"
                                            FontSize="14"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            Style="{StaticResource ContentTextStyle}"
                                            Text="{Binding Arremessos3PontosConvertidos}" />
                                        <Entry
                                            Grid.Column="12"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                              Dark=#282828}"
                                            FontSize="14"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            Style="{StaticResource ContentTextStyle}"
                                            Text="{Binding Arremessos3PontosTentados}" />
                                        <Entry
                                            Grid.Column="13"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                              Dark=#282828}"
                                            FontSize="14"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            Style="{StaticResource ContentTextStyle}"
                                            Text="{Binding LancesLivresConvertidos}" />
                                        <Entry
                                            Grid.Column="14"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                              Dark=#282828}"
                                            FontSize="14"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            Style="{StaticResource ContentTextStyle}"
                                            Text="{Binding LancesLivresTentados}" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>

                <Button
                    Margin="0,30,0,0"
                    BackgroundColor="#4CAF50"
                    Command="{Binding SalvarEstatisticasCommand}"
                    IsEnabled="{Binding IsNotOcupado}"
                    Style="{StaticResource BotaoPrincipal}"
                    Text="Salvar e Finalizar"
                    TextColor="White" />

                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding EstaOcupado}"
                    IsVisible="{Binding EstaOcupado}"
                    Color="#FF4500" />

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>