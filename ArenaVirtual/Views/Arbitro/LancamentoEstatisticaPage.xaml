                                    Text="PTS"
                                    TextColor="#FF4500" />
                                <Label
                                    Grid.Column="3"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="REB"
                                    TextColor="#FF4500" />
                                <Label
                                    Grid.Column="4"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="AST"
                                    TextColor="#FF4500" />
                                <Label
                                    Grid.Column="5"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="ROU"
                                    TextColor="#FF4500" />
                                <Label
                                    Grid.Column="6"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="BLO"
                                    TextColor="#FF4500" />
                                <Label
                                    Grid.Column="7"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="TOV"
                                    TextColor="#FF4500" />
                                <Label
                                    Grid.Column="8"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="Faltas"
                                    TextColor="#FF4500" />

                                <Label
                                    Grid.Column="9"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="2C"
                                    TextColor="#FF4500" />
                                <Label
                                    Grid.Column="10"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="2T"
                                    TextColor="#FF4500" />
                                <Label
                                    Grid.Column="11"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="3C"
                                    TextColor="#FF4500" />
                                <Label
                                    Grid.Column="12"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="3T"
                                    TextColor="#FF4500" />
                                <Label
                                    Grid.Column="13"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="LLC"
                                    TextColor="#FF4500" />
                                <Label
                                    Grid.Column="14"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="LLT"
                                    TextColor="#FF4500" />
                            </Grid>
                        </CollectionView.Header>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AtletaEstatisticaItem">
                                <Frame
                                    Margin="0,2"
                                    Padding="5"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray400},
                                                                      Dark=#282828}"
                                    CornerRadius="5">
                                    <Grid ColumnDefinitions="40, *, 60, 60, 60, 60, 60, 60, 70, 70, 70, 70, 70, 70, 70">

                                        <Image
                                            Grid.Column="0"
                                            Margin="0,0,5,0"
                                            HeightRequest="30"
                                            HorizontalOptions="Center"
                                            Source="{Binding FotoAtletaUrl}"
                                            VerticalOptions="Center"
                                            WidthRequest="30">
                                            <Image.Clip>
                                                <EllipseGeometry
                                                    Center="15, 15"
                                                    RadiusX="15"
                                                    RadiusY="15" />
                                            </Image.Clip>
                                        </Image>

                                        <Label
                                            Grid.Column="1"
                                            Margin="5,0"
                                            FontSize="14"
                                            Style="{StaticResource ContentTextStyle}"
                                            Text="{Binding NomeAtleta}"
                                            VerticalOptions="Center" />

                                        <Entry
                                            Grid.Column="2"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                              Dark=#282828}"
                                            FontSize="14"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            Style="{StaticResource ContentTextStyle}"
                                            Text="{Binding Pontos}" />
                                        <Entry
                                            Grid.Column="3"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                              Dark=#282828}"
                                            FontSize="14"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            Style="{StaticResource ContentTextStyle}"
                                            Text="{Binding Rebotes}" />
                                        <Entry
                                            Grid.Column="4"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                              Dark=#282828}"
                                            FontSize="14"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            Style="{StaticResource ContentTextStyle}"
                                            Text="{Binding Assistencias}" />
                                        <Entry
                                            Grid.Column="5"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                              Dark=#282828}"
                                            FontSize="14"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            Placeholder="0"
