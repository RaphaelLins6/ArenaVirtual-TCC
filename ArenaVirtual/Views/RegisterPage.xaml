<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ArenaVirtual.Models"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels"
    Title="Registrar"
    x:DataType="vm:RegisterViewModel">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="15">
                <Entry Placeholder="Nome" Text="{Binding Nome}" />
                <Entry
                    Keyboard="Email"
                    Placeholder="Email"
                    Text="{Binding Email}" />

                <Picker
                    Title="Selecione o perfil"
                    ItemsSource="{Binding PerfisDisponiveis}"
                    SelectedItem="{Binding PerfilSelecionado}" />

                <Entry Placeholder="Telefone/WhatsApp" Text="{Binding Telefone}" />
                <Entry Placeholder="Localização (Cidade/Estado)" Text="{Binding Localizacao}" />
                <Entry Placeholder="Link Rede Social" Text="{Binding LinkRedeSocial}" />
                <Entry
                    Completed="OnRegisterEnterPressed"
                    IsPassword="True"
                    Placeholder="Senha"
                    Text="{Binding Senha}" />
                <Entry
                    IsPassword="True"
                    Placeholder="Confirmar Senha"
                    Text="{Binding ConfirmarSenha}" />

                <VerticalStackLayout
                    x:Name="PatrocinadorFields"
                    IsVisible="{Binding PerfilSelecionado, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:TipoPerfil.Patrocinador}}"
                    Spacing="10">
                    <Entry Placeholder="Nome da Empresa" Text="{Binding NomeEmpresa}" />
                    <Entry Placeholder="CNPJ/CPF" Text="{Binding Cnpj}" />
                    <Entry Placeholder="Faixa de Orçamento para Patrocínio" Text="{Binding FaixaOrcamentoPatrocinio}" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    x:Name="OrganizadorFields"
                    IsVisible="{Binding PerfilSelecionado, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:TipoPerfil.Organizador}}"
                    Spacing="10">
                    <Entry Placeholder="Nome da Empresa" Text="{Binding NomeEmpresa}" />
                    <Entry Placeholder="CNPJ/CPF" Text="{Binding Cnpj}" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    x:Name="AtletaFields"
                    IsVisible="{Binding PerfilSelecionado, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:TipoPerfil.Atleta}}"
                    Spacing="10">
                    <Entry
                        Keyboard="Numeric"
                        Placeholder="Altura (cm)"
                        Text="{Binding Altura}" />
                    <Entry
                        Keyboard="Numeric"
                        Placeholder="Peso (kg)"
                        Text="{Binding Peso}" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    x:Name="DataNascimentoGeneroFields"
                    IsVisible="{Binding PerfilSelecionado, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:TipoPerfil.Atleta}}"
                    Spacing="10">
                    <Picker
                        Title="Gênero"
                        ItemsSource="{Binding GenerosDisponiveis}"
                        SelectedItem="{Binding GeneroSelecionado}" />
                    <Label Text="Data de Nascimento:" TextColor="White" />
                    <DatePicker Date="{Binding DataNascimento, Mode=TwoWay}" Format="dd/MM/yyyy" />
                </VerticalStackLayout>

                <Button
                    Command="{Binding RegistrarCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverterBooleanConverter}}"
                    Style="{StaticResource BotaoPrincipal}"
                    Text="Registrar" />
                <Button
                    Command="{Binding VoltarParaLoginCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverterBooleanConverter}}"
                    Style="{StaticResource BotaoPrincipal}"
                    Text="Voltar" />
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center"
            Color="OrangeRed" />
    </Grid>
</ContentPage>