<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.Organizador.EditarCampeonatoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ArenaVirtual.Converters"
    Title="Editar Campeonato">

    <ContentPage.Resources>
        <converters:StringNotNullOrEmptyConverter x:Key="StringIsNotNullOrEmptyConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="20" Spacing="16">
            <Label
                FontSize="24"
                HorizontalOptions="Center"
                Text="Editar Campeonato"
                TextColor="White" />

            <Label
                FontSize="14"
                HorizontalOptions="Center"
                IsVisible="{Binding ValidationMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                Text="{Binding ValidationMessage}"
                TextColor="Red" />

            <Entry Placeholder="Nome do campeonato" Text="{Binding Campeonato.Nome}" />
            <Entry Placeholder="Local" Text="{Binding Campeonato.Local}" />
            <Button
                Command="{Binding SelecionarLogoCommand}"
                Style="{StaticResource BotaoPrincipal}"
                Text="Selecionar Logo" />
            <Image
                Margin="0,10,0,0"
                Aspect="AspectFit"
                HeightRequest="100"
                Source="{Binding LogoImageSource}"
                WidthRequest="100" />
            <Entry Placeholder="Nome do organizador" Text="{Binding Campeonato.NomeOrganizador}" />
            <Entry
                Keyboard="Email"
                Placeholder="Email do organizador"
                Text="{Binding Campeonato.EmailOrganizador}" />
            <Entry
                Keyboard="Telephone"
                Placeholder="Telefone do organizador"
                Text="{Binding Campeonato.TelefoneOrganizador}" />

            <Label Style="{StaticResource LabelHeaderStyle}" Text="Formato do Campeonato" />
            <Picker
                Title="Selecione o Formato"
                SelectedItem="{Binding Campeonato.FormatoCampeonato}"
                Style="{StaticResource PickerStyle}">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Pontos Corridos</x:String>
                        <x:String>Mata-Mata</x:String>
                        <x:String>Pontos + Eliminatórias</x:String>
                        <x:String>Grupos + Eliminatórias</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Entry Placeholder="Locais dos jogos" Text="{Binding Campeonato.LocaisDosJogos}" />

            <Label Text="Data de Início" />
            <DatePicker Date="{Binding Campeonato.DataInicio}" Format="dd/MM/yyyy" />

            <Label Text="Data de Fim" />
            <DatePicker Date="{Binding Campeonato.DataFim}" Format="dd/MM/yyyy" />

            <Label Text="Número máximo de equipes" />
            <Entry Keyboard="Numeric" Text="{Binding NumeroMaximoEquipesText}" />

            <Label Text="Valor da taxa de inscrição" />
            <Entry Keyboard="Numeric" Text="{Binding ValorTaxaInscricaoText}" />

            <StackLayout Orientation="Horizontal" VerticalOptions="Center">
                <Label Text="Haverá premiação?" VerticalOptions="Center" />
                <Switch IsToggled="{Binding Campeonato.HaveraPremiacao}" />
            </StackLayout>

            <Button
                Padding="12,6"
                Command="{Binding SalvarCommand}"
                CornerRadius="8"
                Style="{StaticResource BotaoPrincipal}"
                Text="Salvar"
                TextColor="White" />
        </StackLayout>
    </ScrollView>
</ContentPage>