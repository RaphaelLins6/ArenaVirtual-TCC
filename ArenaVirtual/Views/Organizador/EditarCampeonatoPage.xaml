<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.Organizador.EditarCampeonatoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:ArenaVirtual.Behaviors"
    xmlns:converters="clr-namespace:ArenaVirtual.Converters"
    Title="Editar Campeonato">

    <ContentPage.Resources>
        <converters:StringNotNullOrEmptyConverter x:Key="StringIsNotNullOrEmptyConverter" />
        <converters:InverterBooleanConverter x:Key="InverterBooleanConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="20" Spacing="16">
            <Label
                FontSize="24"
                HorizontalOptions="Center"
                Style="{StaticResource ContentTextStyle}"
                Text="Editar Campeonato" />

            <Label
                FontSize="14"
                HorizontalOptions="Center"
                IsVisible="{Binding ValidationMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                Text="{Binding ValidationMessage}"
                TextColor="Red" />

            <Entry
                Placeholder="Nome do campeonato"
                Style="{StaticResource EntryStyle}"
                Text="{Binding Campeonato.Nome}" />
            <Entry
                Placeholder="Local"
                Style="{StaticResource EntryStyle}"
                Text="{Binding Campeonato.Local}" />
            <Button
                Command="{Binding SelecionarLogoCommand}"
                Style="{StaticResource BotaoPrincipal}"
                Text="Selecionar Logo" />
            <Image
                Margin="0,10,0,0"
                Aspect="AspectFit"
                HeightRequest="100"
                Source="{Binding LogoImageSource}"
                WidthRequest="100" />
            <Entry
                Placeholder="Nome do organizador"
                Style="{StaticResource EntryStyle}"
                Text="{Binding Campeonato.NomeOrganizador}" />
            <Entry
                Keyboard="Email"
                Placeholder="Email do organizador"
                Style="{StaticResource EntryStyle}"
                Text="{Binding Campeonato.EmailOrganizador}" />
            <Entry
                Keyboard="Telephone"
                Placeholder="Telefone do organizador"
                Style="{StaticResource EntryStyle}"
                Text="{Binding Campeonato.TelefoneOrganizador}">
                <Entry.Behaviors>
                    <behaviors:MaskBehavior Mask="PHONE" />
                </Entry.Behaviors>
            </Entry>

            <Label
                FontSize="14"
                Style="{StaticResource ContentTextStyle}"
                Text="Formato do Campeonato" />
            <Picker
                Title="Selecione o Formato"
                SelectedItem="{Binding Campeonato.FormatoCampeonato}"
                Style="{StaticResource PickerStyle}">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Pontos Corridos</x:String>
                        <x:String>Mata-Mata</x:String>
                        <x:String>Pontos + Eliminatórias</x:String>
                        <x:String>Grupos + Eliminatórias</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Entry
                Placeholder="Locais dos jogos"
                Style="{StaticResource EntryStyle}"
                Text="{Binding Campeonato.LocaisDosJogos}" />

            <Label Style="{StaticResource ContentTextStyle}" Text="Data de Início" />
            <DatePicker
                Date="{Binding Campeonato.DataInicio}"
                Format="dd/MM/yyyy"
                Style="{StaticResource PickerStyle}" />

            <Label Style="{StaticResource ContentTextStyle}" Text="Data de Fim" />
            <DatePicker
                Date="{Binding Campeonato.DataFim}"
                Format="dd/MM/yyyy"
                Style="{StaticResource PickerStyle}" />

            <Label Style="{StaticResource ContentTextStyle}" Text="Número máximo de equipes" />
            <Entry
                Keyboard="Numeric"
                Style="{StaticResource EntryStyle}"
                Text="{Binding NumeroMaximoEquipesText}" />

            <Label Style="{StaticResource ContentTextStyle}" Text="Valor da taxa de inscrição" />
            <Entry
                Keyboard="Numeric"
                Style="{StaticResource EntryStyle}"
                Text="{Binding ValorTaxaInscricaoText}" />

            <StackLayout Orientation="Horizontal" VerticalOptions="Center">
                <Label
                    Style="{StaticResource ContentTextStyle}"
                    Text="Haverá premiação?"
                    VerticalOptions="Center" />
                <Switch IsToggled="{Binding Campeonato.HaveraPremiacao}" />
            </StackLayout>

            <Button
                Padding="12,6"
                Command="{Binding SalvarCommand}"
                CornerRadius="8"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverterBooleanConverter}}"
                Style="{StaticResource BotaoPrincipal}"
                Text="Salvar"
                TextColor="White" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="White" />

        </StackLayout>
    </ScrollView>
</ContentPage>