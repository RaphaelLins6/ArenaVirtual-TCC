<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.Organizador.DashboardOrganizadorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <StackLayout Padding="20" Spacing="16">
            <Label
                FontSize="20"
                HorizontalOptions="Center"
                Style="{StaticResource ContentTextStyle}"
                Text="Campeonatos" />

            <CollectionView ItemsSource="{Binding Campeonatos}">
                <CollectionView.EmptyView>
                    <Label
                        HorizontalOptions="Center"
                        Style="{StaticResource ContentTextStyle}"
                        Text="Nenhum campeonato cadastrado."
                        VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,24"
                            Padding="10"
                            Stroke="Gray"
                            StrokeShape="RoundRectangle 8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Column="0"
                                    Aspect="AspectFill"
                                    HeightRequest="60"
                                    HorizontalOptions="Center"
                                    Source="{Binding LogoUrl}"
                                    VerticalOptions="Center"
                                    WidthRequest="60" />
                                <StackLayout
                                    Grid.Column="1"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource ContentTextStyle}"
                                        Text="{Binding Nome}" />
                                    <Label
                                        FontSize="14"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource ContentTextStyle}"
                                        Text="{Binding Local}" />
                                    <Label
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource ContentTextStyle}"
                                        Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" />
                                    <Label
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource ContentTextStyle}"
                                        Text="{Binding DataFim, StringFormat='Fim: {0:dd/MM/yyyy}'}" />
                                    <HorizontalStackLayout
                                        Margin="0,10,0,0"
                                        HorizontalOptions="Center"
                                        Spacing="12">
                                        <Button
                                            Padding="10,4"
                                            BackgroundColor="#2196F3"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCampeonatoCommand}"
                                            CommandParameter="{Binding .}"
                                            CornerRadius="6"
                                            Style="{StaticResource BotaoPrincipal}"
                                            Text="Editar"
                                            TextColor="White" />

                                        <Button
                                            Padding="10,4"
                                            BackgroundColor="#F44336"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoverCampeonatoCommand}"
                                            CommandParameter="{Binding .}"
                                            CornerRadius="6"
                                            Style="{StaticResource BotaoPrincipal}"
                                            Text="Excluir"
                                            TextColor="White" />
                                    </HorizontalStackLayout>
                                </StackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ScrollView>
</ContentPage>