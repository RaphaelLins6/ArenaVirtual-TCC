<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.Organizador.CriarCampeonatoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ArenaVirtual.Converters"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels"
    Title="Criar Campeonato"
    x:DataType="vm:CriarCampeonatoViewModel">

    <ContentPage.Resources>
        <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
        <Style x:Key="LabelHeaderStyle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="Medium" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label Style="{StaticResource LabelHeaderStyle}" Text="Nome do Campeonato" />
                <Entry
                    Placeholder="Nome do Campeonato"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding Nome}" />

                <Label Style="{StaticResource LabelHeaderStyle}" Text="Logo do Campeonato" />
                <Button
                    Command="{Binding SelecionarLogoCommand}"
                    Style="{StaticResource BotaoPrincipal}"
                    Text="Selecionar Logo" />
                <Image
                    Margin="0,10,0,0"
                    Aspect="AspectFit"
                    HeightRequest="100"
                    Source="{Binding LogoImageSource}"
                    WidthRequest="100" />

                <Label Style="{StaticResource LabelHeaderStyle}" Text="Nome do Organizador/Organização" />
                <Entry
                    Placeholder="Ex: Sua Empresa S.A. ou Seu Nome"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding NomeOrganizador}" />

                <Label Style="{StaticResource LabelHeaderStyle}" Text="Email do Organizador/Organização" />
                <Entry
                    Keyboard="Email"
                    Placeholder="email@exemplo.com"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding EmailOrganizador}" />

                <Label Style="{StaticResource LabelHeaderStyle}" Text="Telefone do Organizador" />
                <Entry
                    Keyboard="Telephone"
                    Placeholder="(XX) XXXXX-XXXX"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding TelefoneOrganizador}" />

                <Label Style="{StaticResource LabelHeaderStyle}" Text="Local do Campeonato" />
                <Entry
                    Placeholder="Endereço completo ou nome do local"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding Local}" />

                <Label Style="{StaticResource LabelHeaderStyle}" Text="Data de Início" />
                <DatePicker Date="{Binding DataInicio}" Format="dd/MM/yy" />
                <Label Style="{StaticResource LabelHeaderStyle}" Text="Data de Término" />
                <DatePicker
                    Date="{Binding DataFim}"
                    Format="dd/MM/yy"
                    MinimumDate="{Binding DataInicio}" />

                <Label Style="{StaticResource LabelHeaderStyle}" Text="Número Máximo de Equipes" />
                <Entry
                    Keyboard="Numeric"
                    Placeholder="Ex: 16"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding NumeroMaximoEquipesTexto}" />

                <Label Style="{StaticResource LabelHeaderStyle}" Text="Valor da Taxa de Inscrição por Equipe (R$)" />
                <Entry
                    Keyboard="Numeric"
                    Placeholder="Ex: 50.00"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding ValorTaxaInscricaoTexto}" />

                <Label Style="{StaticResource LabelHeaderStyle}" Text="Formato do Campeonato" />
                <Picker
                    Title="Selecione o Formato"
                    SelectedItem="{Binding FormatoCampeonato}"
                    Style="{StaticResource PickerStyle}">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Eliminatória Simples</x:String>
                            <x:String>Eliminatória Dupla</x:String>
                            <x:String>Pontos Corridos</x:String>
                            <x:String>Grupos + Eliminatória</x:String>
                            <x:String>Outro</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label Style="{StaticResource LabelHeaderStyle}" Text="Local(is) dos Jogos" />
                <Editor
                    AutoSize="TextChanges"
                    HeightRequest="80"
                    Placeholder="Descreva os locais dos jogos (pode ser mais de um)"
                    Style="{StaticResource EditorStyle}"
                    Text="{Binding LocaisDosJogos}" />

                <StackLayout
                    Margin="0,10,0,0"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontSize="Medium"
                        Text="Haverá Premiação?"
                        TextColor="White"
                        VerticalOptions="Center" />
                    <Switch IsToggled="{Binding HaveraPremiacao}" VerticalOptions="Center" />
                </StackLayout>

                <Button
                    Margin="0,20,0,0"
                    Command="{Binding SalvarCampeonatoCommand}"
                    Style="{StaticResource BotaoPrincipal}"
                    Text="Criar Campeonato" />

                <Label
                    HorizontalOptions="Center"
                    IsVisible="{Binding MensagemValidacao, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                    Text="{Binding MensagemValidacao}"
                    TextColor="Red" />

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
