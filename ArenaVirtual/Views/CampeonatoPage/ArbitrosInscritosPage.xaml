<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.CampeonatoPage.ArbitrosInscritosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels.CampeonatoPage"
    Title="Árbitros Inscritos">

    <VerticalStackLayout Padding="10" Spacing="10">

        <Label
            Margin="0,10,0,10"
            FontSize="Title"
            HorizontalOptions="Center"
            Text="Lista de Árbitros Inscritos" />

        <CollectionView ItemsSource="{Binding Arbitros}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Margin="0,5"
                        Padding="10"
                        BackgroundColor="#f0f0f0"
                        CornerRadius="5">
                        <Label
                            FontSize="Medium"
                            Text="{Binding .}"
                            TextColor="Black" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>