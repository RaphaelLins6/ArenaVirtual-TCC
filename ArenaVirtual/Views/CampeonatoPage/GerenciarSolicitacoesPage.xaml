<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.CampeonatoPage.GerenciarSolicitacoesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ArenaVirtual.Converters"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels.CampeonatoPage"
    Title="Gerenciar Solicitações"
    BackgroundColor="{AppThemeBinding Light=#f0f0f0,
                                      Dark=Black}"
    Shell.NavBarIsVisible="True">

    <ContentPage.Resources>
        <converters:NotZeroToTrueConverter x:Key="NotZeroToTrueConverter" />
        <converters:InverterBooleanConverter x:Key="InverterBooleanConverter" />
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding LoadSolicitacoesCommand}" EventName="Loaded" />
    </ContentPage.Behaviors>

    <Grid>
        <VerticalStackLayout Padding="15" Spacing="10">
            <Label
                Margin="0,10,0,0"
                FontAttributes="Bold"
                FontSize="22"
                HorizontalOptions="Center"
                Text="Solicitações de Inscrição"
                TextColor="{AppThemeBinding Light=Black,
                                            Dark=White}" />

            <Label
                FontSize="16"
                HorizontalOptions="Center"
                IsVisible="{Binding IsListEmpty}"
                Text="Nenhuma solicitação pendente."
                TextColor="Gray"
                VerticalOptions="Center" />

            <CollectionView IsVisible="{Binding IsListEmpty, Converter={StaticResource InverterBooleanConverter}}" ItemsSource="{Binding SolicitacoesPendentes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="0,5"
                            Padding="10"
                            Background="{AppThemeBinding Light=White,
                                                         Dark=#1e1e1e}"
                            CornerRadius="10"
                            HasShadow="True">
                            <VerticalStackLayout Spacing="5">
                                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="50"
                                        Source="{Binding ImagemTime}"
                                        VerticalOptions="Center"
                                        WidthRequest="50" />
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            Text="{Binding NomeTime}"
                                            TextColor="{AppThemeBinding Light=Black,
                                                                        Dark=White}" />
                                        <Label
                                            FontSize="14"
                                            Text="{Binding DescricaoTime}"
                                            TextColor="Gray" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                                    <Button
                                        BackgroundColor="#4CAF50"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GerenciarSolicitacoesViewModel}}, Path=AceitarSolicitacaoCommand}"
                                        CommandParameter="{Binding .}"
                                        CornerRadius="20"
                                        Text="Aceitar"
                                        TextColor="White"
                                        WidthRequest="100" />
                                    <Button
                                        BackgroundColor="#F44336"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GerenciarSolicitacoesViewModel}}, Path=RecusarSolicitacaoCommand}"
                                        CommandParameter="{Binding .}"
                                        CornerRadius="20"
                                        Text="Recusar"
                                        TextColor="White"
                                        WidthRequest="100" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>