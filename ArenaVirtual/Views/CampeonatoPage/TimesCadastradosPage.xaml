<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.CampeonatoPage.TimesCadastradosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ArenaVirtual.Converters"
    xmlns:models="clr-namespace:ArenaVirtual.Models"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels.CampeonatoPage"
    Title="Times Cadastrados"
    x:DataType="vm:TimesCadastradosViewModel"
    BackgroundColor="#1E1E1E"
    Shell.NavBarIsVisible="True">

    <ContentPage.Content>
        <VerticalStackLayout Padding="15,10" Spacing="10">

            <Label
                FontAttributes="Bold"
                FontSize="22"
                Text="Participantes"
                TextColor="White" />

            <CollectionView ItemsSource="{Binding Times}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,30,0,0" VerticalOptions="Start">
                        <Label
                            FontSize="Medium"
                            HorizontalOptions="Center"
                            Text="Nenhum time cadastrado neste campeonato ainda."
                            TextColor="Gray"
                            VerticalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Time">
                        <Frame
                            Margin="0,5"
                            Padding="10"
                            BackgroundColor="#282828"
                            CornerRadius="5"
                            HasShadow="False">
                            <Grid ColumnDefinitions="50, *, Auto" ColumnSpacing="15">
                                <Image
                                    Grid.Column="0"
                                    Aspect="AspectFit"
                                    HeightRequest="40"
                                    HorizontalOptions="Center"
                                    Source="{Binding LogoUrl}"
                                    WidthRequest="40" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="{Binding Nome}"
                                        TextColor="OrangeRed" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="2"
                                    Padding="10,0"
                                    BackgroundColor="#CC0000"
                                    Clicked="RemoverTime_Clicked"
                                    CornerRadius="5"
                                    FontSize="Small"
                                    MaximumWidthRequest="150"
                                    Style="{StaticResource BotaoPrincipal}"
                                    Text="Remover"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>