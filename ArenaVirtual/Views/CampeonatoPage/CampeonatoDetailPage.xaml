<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.CampeonatoPage.CampeonatoDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArenaVirtual.Views.CampeonatoPage"
    xmlns:models="clr-namespace:ArenaVirtual.Models"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels.CampeonatoPage"
    x:DataType="vm:CampeonatoDetailViewModel"
    Shell.FlyoutBehavior="Disabled">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Spacing="25">
                <Grid HeightRequest="200">
                    <Image Aspect="AspectFill" Source="{Binding BannerSource}" />

                    <ImageButton
                        Margin="10"
                        BackgroundColor="Transparent"
                        Command="{Binding AlterarBannerCommand}"
                        HeightRequest="40"
                        HorizontalOptions="End"
                        IsVisible="{Binding IsOrganizador}"
                        Source="icone_editar.png"
                        VerticalOptions="Start"
                        WidthRequest="40" />

                    <VerticalStackLayout
                        Margin="15"
                        HorizontalOptions="Center"
                        Spacing="5"
                        VerticalOptions="Center">
                        <Frame
                            Padding="5"
                            BackgroundColor="#282828"
                            CornerRadius="50"
                            HasShadow="False"
                            HeightRequest="80"
                            IsClippedToBounds="True"
                            WidthRequest="80">
                            <Image
                                Aspect="AspectFit"
                                HeightRequest="80"
                                HorizontalOptions="Center"
                                Source="{Binding LogoSource}"
                                WidthRequest="80" />
                        </Frame>
                        <Label
                            FontAttributes="Bold"
                            FontSize="24"
                            HorizontalOptions="Center"
                            Text="{Binding Campeonato.Nome}"
                            TextColor="OrangeRed" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout
                    Padding="15,0"
                    HorizontalOptions="Center"
                    Spacing="5">
                    <Label Text="{Binding Campeonato.Local}" TextColor="OrangeRed" />
                    <Label Text="{Binding Campeonato.DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" TextColor="OrangeRed" />
                    <Label Text="{Binding Campeonato.DataFim, StringFormat='Fim: {0:dd/MM/yyyy}'}" TextColor="OrangeRed" />

                    <Button
                        Margin="0,15,0,0"
                        BackgroundColor="OrangeRed"
                        Command="{Binding GerenciarSolicitacoesCommand}"
                        CornerRadius="10"
                        IsVisible="{Binding IsOrganizador}"
                        Text="Gerenciar Solicitações"
                        TextColor="White" />

                    <Button
                        Margin="0,5,0,0"
                        BackgroundColor="DarkOrange"
                        Command="{Binding ListarTimesInscritosCommand}"
                        CornerRadius="10"
                        IsVisible="{Binding IsOrganizador}"
                        Text="Ver Times Inscritos"
                        TextColor="White" />

                    <Button
                        Margin="0,5,0,0"
                        BackgroundColor="Orange"
                        Command="{Binding ListarArbitrosInscritosCommand}"
                        CornerRadius="10"
                        IsVisible="{Binding IsOrganizador}"
                        Text="Ver Árbitros Inscritos"
                        TextColor="White" />
                </VerticalStackLayout>

                <BoxView
                    HeightRequest="1"
                    HorizontalOptions="FillAndExpand"
                    Color="Gray" />

                <VerticalStackLayout Padding="15,0" Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Tabela de Classificação"
                        TextColor="White" />

                    <Grid Padding="0,5" ColumnDefinitions="40, 40, *, 40, 40, 60, 40, 60, 60">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Text="#"
                            TextColor="Orange" />
                        <Label
                            Grid.Column="2"
                            FontAttributes="Bold"
                            Text="Time"
                            TextColor="Orange" />
                        <Label
                            Grid.Column="3"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Text="V"
                            TextColor="Orange" />
                        <Label
                            Grid.Column="4"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Text="D"
                            TextColor="Orange" />
                        <Label
                            Grid.Column="5"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Text="Vit%"
                            TextColor="Orange" />
                        <Label
                            Grid.Column="6"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsDesktop}"
                            Text="JA"
                            TextColor="Orange" />
                        <Label
                            Grid.Column="7"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsDesktop}"
                            Text="Total Pts."
                            TextColor="Orange" />
                        <Label
                            Grid.Column="8"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsDesktop}"
                            Text="Seq."
                            TextColor="Orange" />
                    </Grid>

                    <CollectionView
                        HorizontalOptions="Start"
                        ItemsSource="{Binding TabelaClassificacao}"
                        VerticalOptions="Start">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Time">
                                <Grid
                                    Padding="0,5"
                                    BackgroundColor="#282828"
                                    ColumnDefinitions="40, 40, *, 40, 40, 60, 40, 60, 60">
                                    <Label
                                        Grid.Column="0"
                                        HorizontalOptions="Center"
                                        Text="{Binding Posicao}"
                                        TextColor="White" />
                                    <Image
                                        Grid.Column="1"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                        Source="{Binding LogoUrl}"
                                        WidthRequest="30" />
                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding Nome}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="3"
                                        HorizontalOptions="Center"
                                        Text="{Binding Vitorias}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="4"
                                        HorizontalOptions="Center"
                                        Text="{Binding Derrotas}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="5"
                                        HorizontalOptions="Center"
                                        Text="{Binding PorcentagemVitoria, StringFormat='{0:P0}'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="6"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CampeonatoDetailViewModel}}, Path=IsDesktop}"
                                        Text="{Binding JogosAtras}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="7"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CampeonatoDetailViewModel}}, Path=IsDesktop}"
                                        Text="{Binding PontuacaoTotal}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="8"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CampeonatoDetailViewModel}}, Path=IsDesktop}"
                                        Text="{Binding Sequencia}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <BoxView
                    HeightRequest="1"
                    HorizontalOptions="FillAndExpand"
                    Color="Gray" />

                <VerticalStackLayout Padding="15,0" Spacing="10">
                    <Grid
                        ColumnDefinitions="*, Auto, *"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="250">
                        <Button
                            Grid.Column="0"
                            Margin="0,0,15,0"
                            BackgroundColor="OrangeRed"
                            BorderColor="black"
                            BorderWidth="1"
                            Command="{Binding MudarRodadaAnteriorCommand}"
                            CornerRadius="10"
                            HeightRequest="35"
                            HorizontalOptions="End"
                            Text="&lt;"
                            WidthRequest="35" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="{Binding RodadaAtual, StringFormat='RODADA {0}'}"
                            TextColor="White"
                            VerticalOptions="Center" />
                        <Button
                            Grid.Column="2"
                            Margin="15,0,0,0"
                            BackgroundColor="OrangeRed"
                            BorderColor="black"
                            BorderWidth="1"
                            Command="{Binding MudarRodadaProximaCommand}"
                            CornerRadius="10"
                            HeightRequest="35"
                            HorizontalOptions="Start"
                            Text="&gt;"
                            WidthRequest="35" />
                    </Grid>

                    <CollectionView
                        HorizontalOptions="Start"
                        ItemsSource="{Binding TabelaJogos}"
                        VerticalOptions="Start">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Jogo">
                                <Frame
                                    Margin="0,5"
                                    Padding="15"
                                    BackgroundColor="#282828"
                                    CornerRadius="5">
                                    <VerticalStackLayout Spacing="5">
                                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="{Binding DataHora, StringFormat='{0:ddd, dd/MM - HH:mm}'}"
                                                TextColor="Gray" />
                                        </HorizontalStackLayout>
                                        <Label
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            Text="{Binding Local}"
                                            TextColor="OrangeRed"
                                            VerticalOptions="Center" />
                                        <Grid
                                            Margin="0,5,0,0"
                                            ColumnDefinitions="*, Auto, *"
                                            ColumnSpacing="10"
                                            HorizontalOptions="FillAndExpand"
                                            RowDefinitions="Auto, Auto">

                                            <HorizontalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="End"
                                                Spacing="5">
                                                <Label
                                                    FontAttributes="Bold"
                                                    Text="{Binding PlacarA}"
                                                    TextColor="OrangeRed"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    FontAttributes="Bold"
                                                    Text="-"
                                                    TextColor="OrangeRed"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                HorizontalOptions="Center"
                                                Text="vs"
                                                TextColor="White"
                                                VerticalOptions="Center" />

                                            <HorizontalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                HorizontalOptions="Start"
                                                Spacing="5">
                                                <Label
                                                    FontAttributes="Bold"
                                                    Text="-"
                                                    TextColor="OrangeRed"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    FontAttributes="Bold"
                                                    Text="{Binding PlacarB}"
                                                    TextColor="OrangeRed"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <Image
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Aspect="AspectFit"
                                                HeightRequest="40"
                                                HorizontalOptions="End"
                                                Source="{Binding TimeA.LogoUrl}"
                                                VerticalOptions="Center" />
                                            <Image
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Aspect="AspectFit"
                                                HeightRequest="40"
                                                HorizontalOptions="Start"
                                                Source="{Binding TimeB.LogoUrl}"
                                                VerticalOptions="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="10">
                                            <Label
                                                Grid.Column="0"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                HorizontalOptions="End"
                                                Text="{Binding TimeA.Nome}"
                                                TextColor="White" />
                                            <Label
                                                Grid.Column="2"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                HorizontalOptions="Start"
                                                Text="{Binding TimeB.Nome}"
                                                TextColor="White" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>