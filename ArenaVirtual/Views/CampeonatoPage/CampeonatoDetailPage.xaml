<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.CampeonatoPage.CampeonatoDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ArenaVirtual.Converters"
    xmlns:local="clr-namespace:ArenaVirtual.Views.CampeonatoPage"
    xmlns:models="clr-namespace:ArenaVirtual.Models"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels.CampeonatoPage"
    x:Name="PageRoot"
    x:DataType="vm:CampeonatoDetailViewModel">

    <ContentPage.Resources>
        <converters:IntToPhaseNameConverter x:Key="PhaseNameConverter" />
        <converters:IntToBracketMarginConverter x:Key="BracketMarginConverter" />

        <converters:SequenciaToColorConverter x:Key="SequenciaToColorConverter" />
    </ContentPage.Resources>

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Spacing="25">

                <Grid HeightRequest="200">
                    <Image Aspect="AspectFill" Source="{Binding BannerSource}" />

                    <ImageButton
                        Margin="10"
                        BackgroundColor="Transparent"
                        Command="{Binding AlterarBannerCommand}"
                        HeightRequest="15"
                        HorizontalOptions="End"
                        IsVisible="{Binding IsOrganizador}"
                        Source="icone_editar.png"
                        VerticalOptions="Start"
                        WidthRequest="15" />

                    <VerticalStackLayout
                        Margin="0,30,0,0"
                        HorizontalOptions="Center"
                        Spacing="5"
                        VerticalOptions="CenterAndExpand">

                        <Frame
                            Padding="0"
                            BackgroundColor="#282828"
                            CornerRadius="50"
                            HasShadow="False"
                            HeightRequest="80"
                            IsClippedToBounds="True"
                            WidthRequest="80">
                            <Image
                                Aspect="AspectFill"
                                HeightRequest="80"
                                HorizontalOptions="Center"
                                Source="{Binding LogoSource}"
                                WidthRequest="80" />

                        </Frame>
                        <Label
                            FontAttributes="Bold"
                            FontSize="24"
                            HorizontalOptions="Center"
                            Text="{Binding Campeonato.Nome}"
                            TextColor="White" />

                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout
                    Padding="15,0"
                    HorizontalOptions="Center"
                    Spacing="5">
                    <Label Text="{Binding Campeonato.Local}" TextColor="OrangeRed" />

                    <Label Text="{Binding Campeonato.DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" TextColor="OrangeRed" />
                    <Label Text="{Binding Campeonato.DataFim, StringFormat='Fim: {0:dd/MM/yyyy}'}" TextColor="OrangeRed" />

                    <Button
                        Margin="0,15,0,0"
                        BackgroundColor="OrangeRed"
                        Command="{Binding GerenciarSolicitacoesCommand}"
                        CornerRadius="10"
                        IsVisible="{Binding IsOrganizador}"
                        Style="{StaticResource BotaoPrincipal}"
                        Text="Gerenciar Solicitações"
                        TextColor="White" />


                    <Button
                        Margin="0,5,0,0"
                        BackgroundColor="DarkOrange"
                        Command="{Binding ListarTimesInscritosCommand}"
                        CornerRadius="10"
                        IsVisible="{Binding IsOrganizador}"
                        Style="{StaticResource BotaoPrincipal}"
                        Text="Ver Times Inscritos"
                        TextColor="White" />

                    <Button
                        Margin="0,5,0,0"
                        BackgroundColor="Orange"
                        Command="{Binding ListarArbitrosInscritosCommand}"
                        CornerRadius="10"
                        IsVisible="{Binding IsOrganizador}"
                        Style="{StaticResource BotaoPrincipal}"
                        Text="Ver Árbitros Inscritos"
                        TextColor="White" />

                </VerticalStackLayout>

                <BoxView
                    HeightRequest="1"
                    HorizontalOptions="FillAndExpand"
                    Color="Gray" />

                <VerticalStackLayout
                    Padding="0"
                    IsVisible="{Binding IsPatrocinioDivulgacaoVisible}"
                    Spacing="0">

                    <Label
                        Margin="15,0,15,5"
                        FontAttributes="Bold"
                        FontSize="Subtitle"
                        HorizontalOptions="Center"
                        Text="Patrocínio Principal"
                        TextColor="White" />

                    <Grid Margin="0" HeightRequest="300">
                        <Image Aspect="AspectFill" Source="{Binding BannerDivulgacaoSource}" />

                        <ImageButton
                            Margin="10"
                            BackgroundColor="Transparent"
                            Command="{Binding AlterarBannerDivulgacaoCommand}"
                            HeightRequest="15"
                            HorizontalOptions="End"
                            IsVisible="{Binding IsOrganizador}"
                            Source="icone_editar.png"
                            VerticalOptions="Start" />
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout
                    Padding="15,0"
                    IsVisible="{Binding IsFiltroFaseVisivel}"
                    Spacing="10">

                    <Label
                        Margin="0,0,0,5"
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="Center"
                        Text="Fase do Campeonato:"
                        TextColor="White" />

                    <Picker
                        Title="Selecione a Fase"
                        ItemsSource="{Binding FasesDisponiveis}"
                        SelectedItem="{Binding FaseAtual}"
                        Style="{StaticResource PickerStyle}" />

                </VerticalStackLayout>

                <VerticalStackLayout
                    Padding="15,0"
                    IsVisible="{Binding IsFaseTabelaEJogos}"
                    Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="Center"
                        Text="Tabela de Classificação"
                        TextColor="White" />

                    <Picker
                        Title="Selecione o Grupo"
                        IsVisible="{Binding IsFormatoComGrupos}"
                        ItemsSource="{Binding GruposDisponiveis}"
                        SelectedItem="{Binding GrupoSelecionado}"
                        Style="{StaticResource PickerStyle}" />

                    <Grid Padding="0,5" ColumnDefinitions="40, 40, *, 40, 40, 60, 60">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Text="#"
                            TextColor="Orange" />

                        <Label
                            Grid.Column="2"
                            FontAttributes="Bold"
                            Text="Time"
                            TextColor="Orange" />

                        <Label
                            Grid.Column="3"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Text="V"
                            TextColor="Orange" />

                        <Label
                            Grid.Column="4"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Text="D"
                            TextColor="Orange" />

                        <Label
                            Grid.Column="5"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Text="Vit%"
                            TextColor="Orange" />

                        <Label
                            Grid.Column="6"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Text="Seq."
                            TextColor="Orange" />
                    </Grid>

                    <CollectionView
                        HorizontalOptions="Start"
                        ItemsSource="{Binding TabelaClassificacao}"
                        VerticalOptions="Start">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Time">
                                <Grid
                                    Padding="0,5"
                                    BackgroundColor="#282828"
                                    ColumnDefinitions="40, 40, *, 40, 40, 60, 60">

                                    <Label
                                        Grid.Column="0"
                                        HorizontalOptions="Center"
                                        Text="{Binding Posicao}"
                                        TextColor="White" />

                                    <Image
                                        Grid.Column="1"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                        Source="{Binding LogoUrl}"
                                        WidthRequest="30" />

                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding Nome}"
                                        TextColor="White"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="3"
                                        HorizontalOptions="Center"
                                        Text="{Binding Vitorias}"
                                        TextColor="White"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="4"
                                        HorizontalOptions="Center"
                                        Text="{Binding Derrotas}"
                                        TextColor="White"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="5"
                                        HorizontalOptions="Center"
                                        Text="{Binding PorcentagemVitoria, StringFormat='{0:P0}'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />


                                    <Grid
                                        Grid.Column="6"
                                        ColumnDefinitions="*,*,*,*,*"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                        <Label
                                            Grid.Column="0"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            Text="{Binding SequenciaChar1}"
                                            TextColor="{Binding SequenciaChar1, Converter={StaticResource SequenciaToColorConverter}}" />
                                        <Label
                                            Grid.Column="1"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            Text="{Binding SequenciaChar2}"
                                            TextColor="{Binding SequenciaChar2, Converter={StaticResource SequenciaToColorConverter}}" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            Text="{Binding SequenciaChar3}"
                                            TextColor="{Binding SequenciaChar3, Converter={StaticResource SequenciaToColorConverter}}" />
                                        <Label
                                            Grid.Column="3"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            Text="{Binding SequenciaChar4}"
                                            TextColor="{Binding SequenciaChar4, Converter={StaticResource SequenciaToColorConverter}}" />
                                        <Label
                                            Grid.Column="4"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            Text="{Binding SequenciaChar5}"
                                            TextColor="{Binding SequenciaChar5, Converter={StaticResource SequenciaToColorConverter}}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>


                    </CollectionView>
                </VerticalStackLayout>

                <BoxView
                    HeightRequest="1"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsFaseTabelaEJogos}"
                    Color="Gray" />

                <VerticalStackLayout
                    Padding="15,0"
                    IsVisible="{Binding IsFaseTabelaEJogos}"
                    Spacing="10">
                    <Grid
                        ColumnDefinitions="*, Auto, *"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="250">
                        <Button
                            Grid.Column="0"
                            Margin="0,0,15,0"
                            BackgroundColor="OrangeRed"
                            BorderColor="black"
                            BorderWidth="1"
                            Command="{Binding MudarRodadaAnteriorCommand}"
                            CornerRadius="10"
                            HeightRequest="35"
                            HorizontalOptions="End"
                            Text="&lt;"
                            WidthRequest="35" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="{Binding RodadaAtual, StringFormat='RODADA {0}'}"
                            TextColor="White"
                            VerticalOptions="Center" />
                        <Button
                            Grid.Column="2"
                            Margin="15,0,0,0"
                            BackgroundColor="OrangeRed"
                            BorderColor="black"
                            BorderWidth="1"
                            Command="{Binding MudarRodadaProximaCommand}"
                            CornerRadius="10"
                            HeightRequest="35"
                            HorizontalOptions="Start"
                            Text="&gt;"
                            WidthRequest="35" />
                    </Grid>

                    <CollectionView
                        x:Name="ListaJogos"
                        HorizontalOptions="Start"
                        ItemsSource="{Binding TabelaJogos}"
                        VerticalOptions="Start">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Jogo">

                                <Frame
                                    Margin="0,5"
                                    Padding="15"
                                    BackgroundColor="#282828"
                                    CornerRadius="5">


                                    <VerticalStackLayout Spacing="5">
                                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="{Binding DataHora, StringFormat='{0:ddd, dd/MM - HH:mm}'}"
                                                TextColor="Gray" />

                                        </HorizontalStackLayout>
                                        <Label
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            Text="{Binding Local}"
                                            TextColor="OrangeRed"
                                            VerticalOptions="Center" />



                                        <Grid
                                            Margin="0,5,0,0"
                                            ColumnDefinitions="*, Auto, *"
                                            ColumnSpacing="10"
                                            HorizontalOptions="FillAndExpand"
                                            RowDefinitions="Auto, Auto">

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                FontAttributes="Bold"
                                                FontSize="18"
                                                HorizontalOptions="Center"
                                                Text="{Binding PlacarParaExibir}"
                                                TextColor="OrangeRed"
                                                VerticalOptions="Center" />


                                            <Image
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Aspect="AspectFit"
                                                HeightRequest="40"
                                                HorizontalOptions="End"
                                                Source="{Binding TimeA.LogoUrl}"
                                                VerticalOptions="Center" />
                                            <Image
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Aspect="AspectFit"
                                                HeightRequest="40"
                                                HorizontalOptions="Start"
                                                Source="{Binding TimeB.LogoUrl}"
                                                VerticalOptions="Center" />
                                        </Grid>



                                        <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="10">
                                            <Label
                                                Grid.Column="0"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                HorizontalOptions="End"
                                                Text="{Binding TimeA.Nome}"
                                                TextColor="White" />
                                            <Label
                                                Grid.Column="2"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                HorizontalOptions="Start"
                                                Text="{Binding TimeB.Nome}"
                                                TextColor="White" />


                                        </Grid>

                                        <Button
                                            Margin="0,10,0,0"
                                            BackgroundColor="Green"
                                            Clicked="OnAnexarArbitrosClicked"
                                            CommandParameter="{Binding .}"
                                            CornerRadius="5"
                                            FontSize="14"
                                            IsEnabled="{Binding BotaoArbitroHabilitado}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CampeonatoDetailViewModel}}, Path=IsOrganizador}"
                                            MaximumWidthRequest="250"
                                            Style="{StaticResource BotaoPrincipal}"
                                            Text="{Binding TextoBotaoArbitro}"
                                            TextColor="White"
                                            VerticalOptions="End" />
                                    </VerticalStackLayout>


                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>


                </VerticalStackLayout>

                <VerticalStackLayout
                    Padding="15,0"
                    IsVisible="{Binding IsFaseMataMata}"
                    Spacing="10">


                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="Center"
                        Text="MATA-MATA"
                        TextColor="OrangeRed" />

                    <CollectionView
                        Margin="0,10,0,0"
                        HeightRequest="600"
                        HorizontalScrollBarVisibility="Always"
                        ItemsSource="{Binding JogosMataMata}"
                        VerticalScrollBarVisibility="Never">

                        <CollectionView.ItemsLayout>

                            <LinearItemsLayout ItemSpacing="20" Orientation="Horizontal" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RodadaGrouping">


                                <VerticalStackLayout
                                    Margin="{Binding Key, Converter={StaticResource BracketMarginConverter}}"
                                    Spacing="10"
                                    WidthRequest="250">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        HorizontalOptions="Center"
                                        Text="{Binding Key, Converter={StaticResource PhaseNameConverter}}"
                                        TextColor="Orange" />


                                    <CollectionView Margin="0,5,0,0" ItemsSource="{Binding}">
                                        <CollectionView.ItemsLayout>

                                            <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                                        </CollectionView.ItemsLayout>

                                        <CollectionView.ItemTemplate>

                                            <DataTemplate x:DataType="models:Jogo">
                                                <Frame Style="{StaticResource GameCardStyle}">

                                                    <VerticalStackLayout Spacing="5">

                                                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">

                                                            <Label
                                                                FontAttributes="Bold"
                                                                FontSize="12"
                                                                Text="{Binding DataHora, StringFormat='{0:ddd, dd/MM - HH:mm}'}"
                                                                TextColor="Gray" />
                                                        </HorizontalStackLayout>

                                                        <Label
                                                            FontSize="12"
                                                            HorizontalOptions="Center"
                                                            Text="{Binding Local}"
                                                            TextColor="OrangeRed"
                                                            VerticalOptions="Center" />


                                                        <Grid
                                                            Margin="0,5,0,0"
                                                            ColumnDefinitions="*, Auto, *"
                                                            ColumnSpacing="10"
                                                            HorizontalOptions="FillAndExpand"
                                                            RowDefinitions="Auto, Auto">


                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="3"
                                                                FontAttributes="Bold"
                                                                FontSize="18"
                                                                HorizontalOptions="Center"
                                                                Text="{Binding PlacarParaExibir}"
                                                                TextColor="OrangeRed"
                                                                VerticalOptions="Center" />


                                                            <Image
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Aspect="AspectFit"
                                                                HeightRequest="40"
                                                                HorizontalOptions="End"
                                                                Source="{Binding TimeA.LogoUrl}"
                                                                VerticalOptions="Center" />

                                                            <Image
                                                                Grid.Row="1"
                                                                Grid.Column="2"
                                                                Aspect="AspectFit"
                                                                HeightRequest="40"
                                                                HorizontalOptions="Start"
                                                                Source="{Binding TimeB.LogoUrl}"
                                                                VerticalOptions="Center" />

                                                        </Grid>

                                                        <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="10">

                                                            <Label
                                                                Grid.Column="0"
                                                                FontAttributes="Bold"
                                                                FontSize="16"
                                                                HorizontalOptions="End"
                                                                Text="{Binding TimeA.Nome}"
                                                                TextColor="White" />

                                                            <Label
                                                                Grid.Column="2"
                                                                FontAttributes="Bold"
                                                                FontSize="16"
                                                                HorizontalOptions="Start"
                                                                Text="{Binding TimeB.Nome}"
                                                                TextColor="White" />


                                                        </Grid>


                                                        <Button
                                                            Margin="0,10,0,0"
                                                            BackgroundColor="Green"
                                                            Clicked="OnAnexarArbitrosClicked"
                                                            CommandParameter="{Binding .}"
                                                            CornerRadius="5"
                                                            FontSize="14"
                                                            IsEnabled="{Binding BotaoArbitroHabilitado}"
                                                            MaximumWidthRequest="250"
                                                            Style="{StaticResource BotaoPrincipal}"
                                                            Text="{Binding TextoBotaoArbitro}"
                                                            TextColor="White"
                                                            VerticalOptions="End">

                                                            <Button.IsVisible>
                                                                <Binding Path="IsOrganizador" Source="{RelativeSource AncestorType={x:Type vm:CampeonatoDetailViewModel}}" />
                                                            </Button.IsVisible>
                                                        </Button>


                                                    </VerticalStackLayout>
                                                </Frame>


                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>

                                    </CollectionView>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

                <VerticalStackLayout
                    Padding="15,0"
                    IsVisible="{Binding IsFaseEstatisticas}"
                    Spacing="10">

                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="Center"
                        Text="Estatísticas do Campeonato (Médias por Jogo)"
                        TextColor="White" />

                    <CollectionView ItemsSource="{Binding EstatisticasTimes}">
                        <CollectionView.Header>
                            <Grid Padding="5" ColumnDefinitions="50,*,60,60,60,60,60,60,60,60,60,60">
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    Text="Time"
                                    TextColor="Orange" />
                                <Label
                                    Grid.Column="2"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    Text="P/J"
                                    TextColor="Orange" />
                                <Label
                                    Grid.Column="3"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    Text="RBT/J"
                                    TextColor="Orange" />
                                <Label
                                    Grid.Column="4"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    Text="AST/J"
                                    TextColor="Orange" />
                                <Label
                                    Grid.Column="5"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    Text="ROU/J"
                                    TextColor="Orange" />
                                <Label
                                    Grid.Column="6"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    Text="BLO/J"
                                    TextColor="Orange" />
                                <Label
                                    Grid.Column="7"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    Text="T/J"
                                    TextColor="Orange" />
                                <Label
                                    Grid.Column="8"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    Text="F/J"
                                    TextColor="Orange" />

                                <Label
                                    Grid.Column="9"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    Text="2P%"
                                    TextColor="Orange" />
                                <Label
                                    Grid.Column="10"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    Text="3P%"
                                    TextColor="Orange" />
                                <Label
                                    Grid.Column="11"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    Text="LL%"
                                    TextColor="Orange" />
                            </Grid>
                        </CollectionView.Header>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type vm:TimeEstatisticaViewModel}">
                                <Grid
                                    Padding="5"
                                    BackgroundColor="#282828"
                                    ColumnDefinitions="50,*,60,60,60,60,60,60,60,60,60,60">

                                    <Image
                                        Grid.Column="0"
                                        HeightRequest="40"
                                        Source="{Binding logoUrl}"
                                        WidthRequest="40" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding NomeTime}"
                                        TextColor="White"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="2"
                                        HorizontalOptions="Center"
                                        Text="{Binding MediaPontos, StringFormat='{0:F1}'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="3"
                                        HorizontalOptions="Center"
                                        Text="{Binding MediaRebotes, StringFormat='{0:F1}'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="4"
                                        HorizontalOptions="Center"
                                        Text="{Binding MediaAssistencias, StringFormat='{0:F1}'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="5"
                                        HorizontalOptions="Center"
                                        Text="{Binding MediaRoubos, StringFormat='{0:F1}'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="6"
                                        HorizontalOptions="Center"
                                        Text="{Binding MediaBloqueios, StringFormat='{0:F1}'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="7"
                                        HorizontalOptions="Center"
                                        Text="{Binding MediaTurnovers, StringFormat='{0:F1}'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="8"
                                        HorizontalOptions="Center"
                                        Text="{Binding MediaFaltas, StringFormat='{0:F1}'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="9"
                                        HorizontalOptions="Center"
                                        Text="{Binding Percentual2P, StringFormat='{0:F1}'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="10"
                                        HorizontalOptions="Center"
                                        Text="{Binding Percentual3P, StringFormat='{0:F1}'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="11"
                                        HorizontalOptions="Center"
                                        Text="{Binding PercentualLancesLivres, StringFormat='{0:F1}'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>