<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.Organizador.CriarCampeonatoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels"
    x:DataType="vm:CriarCampeonatoViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="Nome do Campeonato"
                    TextColor="White" />
                <Entry
                    Placeholder="Nome do Campeonato"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding Nome}" />
                <Label
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="Logo do Campeonato"
                    TextColor="White" />
                <Button
                    Command="{Binding SelecionarLogoCommand}"
                    Style="{StaticResource BotaoPrincipal}"
                    Text="Selecionar Logo" />
                <Image
                    Margin="0,10,0,0"
                    Aspect="AspectFit"
                    HeightRequest="100"
                    Source="{Binding LogoImageSource}"
                    WidthRequest="100" />
                <Label
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="Nome do Organizador/Organização"
                    TextColor="White" />
                <Entry
                    Placeholder="Ex: Sua Empresa S.A. ou Seu Nome"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding NomeOrganizador}" />

                <Label
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="Email do Organizador/Organização"
                    TextColor="White" />
                <Entry
                    Keyboard="Email"
                    Placeholder="email@exemplo.com"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding EmailOrganizador}" />

                <Label
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="Telefone do Organizador"
                    TextColor="White" />
                <Entry
                    Keyboard="Telephone"
                    Placeholder="(XX) XXXXX-XXXX"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding TelefoneOrganizador}" />

                <Label
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="Local do Campeonato"
                    TextColor="White" />
                <Entry
                    Placeholder="Endereço completo ou nome do local"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding Local}" />

                <Label
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="Data de Início"
                    TextColor="White" />
                <DatePicker Date="{Binding DataInicio}" Format="dd/mm/yy" />
                <Label
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="Data de Término"
                    TextColor="White" />
                <DatePicker
                    Date="{Binding DataFim}"
                    Format="dd/mm/yy"
                    MinimumDate="{Binding DataInicio}" />
                <Label
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="Número Máximo de Equipes"
                    TextColor="White" />
                <Entry
                    Keyboard="Numeric"
                    Placeholder="Ex: 16"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding NumeroMaximoEquipes}" />

                <Label
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="Valor da Taxa de Inscrição por Equipe (R$)"
                    TextColor="White" />
                <Entry
                    Keyboard="Numeric"
                    Placeholder="Ex: 50.00"
                    Style="{StaticResource EntryStyle}"
                    Text="{Binding ValorTaxaInscricao}" />

                <Label
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="Formato do Campeonato"
                    TextColor="White" />
                <Picker
                    Title="Selecione o Formato"
                    SelectedItem="{Binding FormatoCampeonato}"
                    Style="{StaticResource PickerStyle}">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Eliminatória Simples</x:String>
                            <x:String>Eliminatória Dupla</x:String>
                            <x:String>Pontos Corridos</x:String>
                            <x:String>Grupos + Eliminatória</x:String>
                            <x:String>Outro</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="Local(is) dos Jogos"
                    TextColor="White" />
                <Editor
                    AutoSize="TextChanges"
                    HeightRequest="80"
                    Placeholder="Descreva os locais dos jogos (pode ser mais de um)"
                    Style="{StaticResource EditorStyle}"
                    Text="{Binding LocaisDosJogos}" />

                <StackLayout
                    Margin="0,10,0,0"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontSize="Medium"
                        Text="Haverá Premiação?"
                        TextColor="White"
                        VerticalOptions="Center" />
                    <Switch IsToggled="{Binding HaveraPremiacao}" VerticalOptions="Center" />
                </StackLayout>

                <Button
                    Margin="0,20,0,0"
                    Command="{Binding SalvarCampeonatoCommand}"
                    Style="{StaticResource BotaoPrincipal}"
                    Text="Criar Campeonato" />

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>