<ContentPage
    x:Class="ArenaVirtual.Views.Atleta.SolicitacaoTimePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ArenaVirtual.Models"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels.Atleta"
    Title="Solicitações do Time"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5,
                                      Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label
                Margin="0,20,0,0"
                FontAttributes="Bold"
                FontSize="20"
                Text="Convites Pendentes"
                TextColor="{AppThemeBinding Light=#333333,
                                            Dark=White}" />

            <CollectionView ItemsSource="{Binding ConvitesPendentes}">
                <CollectionView.EmptyView>
                    <Label
                        HorizontalOptions="Center"
                        Text="Nenhum convite pendente."
                        VerticalOptions="CenterAndExpand" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="0,5"
                            Padding="10"
                            BackgroundColor="{AppThemeBinding Light=White,
                                                              Dark=#1E1E1E}"
                            CornerRadius="10">

                            <Grid
                                ColumnDefinitions="Auto,*,Auto,Auto"
                                ColumnSpacing="15"
                                VerticalOptions="Center">

                                <Image
                                    Grid.Column="0"
                                    Aspect="AspectFill"
                                    HeightRequest="40"
                                    Source="{Binding UsuarioSolicitante.LogoUrl}"
                                    VerticalOptions="Center"
                                    WidthRequest="40" />

                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding UsuarioSolicitante.Nome}"
                                    VerticalOptions="Center" />

                                <Button
                                    Grid.Column="2"
                                    BackgroundColor="Green"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SolicitacaoTimePageViewModel}}, Path=AceitarConviteCommand}"
                                    CommandParameter="{Binding .}"
                                    Text="Aceitar" />

                                <Button
                                    Grid.Column="3"
                                    BackgroundColor="Red"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SolicitacaoTimePageViewModel}}, Path=RecusarConviteCommand}"
                                    CommandParameter="{Binding .}"
                                    Text="Recusar" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>