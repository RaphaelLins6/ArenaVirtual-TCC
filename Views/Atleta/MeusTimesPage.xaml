<ContentPage
    x:Class="ArenaVirtual.Views.Atleta.MeusTimesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Meu Time"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5,
                                      Dark=#121212}">

    <ContentPage.Content>
        <Grid Padding="15">

            <ScrollView IsVisible="{Binding VinculadoATime}">
                <VerticalStackLayout Spacing="15">

                    <Frame
                        Padding="10"
                        BackgroundColor="{AppThemeBinding Light=White,
                                                          Dark=#1E1E1E}"
                        CornerRadius="20"
                        HasShadow="True">
                        <HorizontalStackLayout Spacing="15">
                            <Image
                                Aspect="AspectFill"
                                HeightRequest="80"
                                Source="{Binding LogoImageSource}"
                                WidthRequest="80" />
                            <VerticalStackLayout>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    Text="{Binding Time.Nome}" />
                                <Label
                                    FontSize="14"
                                    Text="{Binding Time.Descricao}"
                                    TextColor="Gray" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Frame>

                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Membros" />
                    <CollectionView ItemsSource="{Binding MembrosDoTime}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    Margin="0,5"
                                    Padding="8"
                                    BackgroundColor="{AppThemeBinding Light=White,
                                                                      Dark=#1E1E1E}"
                                    CornerRadius="12">
                                    <HorizontalStackLayout Spacing="10">
                                        <Image
                                            Aspect="AspectFill"
                                            HeightRequest="40"
                                            Source="{Binding Foto}"
                                            WidthRequest="40" />
                                        <Label Text="{Binding Nome}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button
                        BackgroundColor="#FF9800"
                        Command="{Binding GerenciarTimeCommand}"
                        CornerRadius="20"
                        Text="Gerenciar Time"
                        TextColor="White" />
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout
                IsVisible="{Binding NaoVinculadoATime}"
                Spacing="20"
                VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalOptions="Center"
                    Text="Você ainda não está em um time!" />

                <Button
                    BackgroundColor="#4CAF50"
                    Command="{Binding CriarMeuTimeCommand}"
                    CornerRadius="20"
                    HorizontalOptions="Center"
                    Text="Criar Time"
                    TextColor="White"
                    WidthRequest="200" />

                <Button
                    BackgroundColor="#2196F3"
                    Command="{Binding EntrarTimeCommand}"
                    CornerRadius="20"
                    HorizontalOptions="Center"
                    Text="Entrar em um Time"
                    TextColor="White"
                    WidthRequest="200" />
            </VerticalStackLayout>

        </Grid>
    </ContentPage.Content>
</ContentPage>