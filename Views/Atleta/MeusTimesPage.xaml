<ContentPage
    x:Class="ArenaVirtual.Views.Atleta.MeusTimesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Meus Times"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid
            Padding="20"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="320">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Botões quando não está em um time  -->
            <StackLayout
                Grid.Row="0"
                Grid.Column="0"
                HorizontalOptions="Center"
                IsVisible="{Binding NaoVinculadoATime}"
                Spacing="12">
                <Label
                    Text="Vi aqui que ainda não tem um time, veja as opções abaixo:"
                    TextColor="White"
                    VerticalOptions="Center"
                    WidthRequest="260" />
                <Button
                    Command="{Binding ProcurarTimesCommand}"
                    CornerRadius="24"
                    Style="{StaticResource BotaoPrincipal}"
                    Text="Procurar Times"
                    TextColor="White"
                    WidthRequest="260" />
                <Button
                    Command="{Binding CriarMeuTimeCommand}"
                    CornerRadius="24"
                    Style="{StaticResource BotaoPrincipal}"
                    Text="Criar Meu Time"
                    TextColor="White"
                    WidthRequest="260" />
            </StackLayout>

            <!--  Exibição do time vinculado  -->
            <StackLayout
                Grid.Row="1"
                Grid.Column="0"
                IsVisible="{Binding VinculadoATime}">
                <Frame
                    Padding="16"
                    BackgroundColor="#f0f0f0"
                    CornerRadius="12">

                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="{Binding Time.Nome}" />

                        <Label Text="{Binding Time.Descricao}" />

                        <Label
                            Margin="0,12,0,0"
                            FontAttributes="Bold"
                            Text="Membros:" />

                        <CollectionView HeightRequest="100" ItemsSource="{Binding Time.Membros}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding Nome}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button
                            BackgroundColor="Orange"
                            Command="{Binding VerDetalhesTimeCommand}"
                            CornerRadius="24"
                            Text="Ver Detalhes do Time"
                            TextColor="White" />
                    </VerticalStackLayout>
                </Frame>
            </StackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
