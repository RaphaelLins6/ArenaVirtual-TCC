<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtuall.Views.Menu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Menu">
    <VerticalStackLayout>
        <Label
            FontSize="32"
            HorizontalOptions="Center"
            Text="Menu"
            VerticalOptions="Center" />

        <!--  Botões do menu  -->
        <Button
            Clicked="OnInicioClicked"
            Style="{StaticResource BotaoPrincipal}"
            Text="Início" />
        <Button
            Clicked="OnCriarCampeonatoClicked"
            Style="{StaticResource BotaoPrincipal}"
            Text="Criar Campeonato" />
        <Button
            Clicked="OnAtletaClicked"
            Style="{StaticResource BotaoPrincipal}"
            Text="Atleta" />

    </VerticalStackLayout>
</ContentPage>