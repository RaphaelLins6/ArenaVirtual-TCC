<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtuall.Views.Menu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Menu">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label
            FontSize="32"
            HorizontalOptions="Center"
            Text="Menu"
            VerticalOptions="Start" />

        <!--  Botão para TelaInicial  -->
        <Button
            Clicked="OnInicioClicked"
            HorizontalOptions="Fill"
            Text="Início" />

        <!--  Botão para CriarCampeonato  -->
        <Button
            Clicked="OnCriarCampeonatoClicked"
            HorizontalOptions="Fill"
            Text="Criar Campeonato" />

        <!--  Botão para PaginaAtleta  -->
        <Button
            Clicked="OnAtletaClicked"
            HorizontalOptions="Fill"
            Text="Atleta" />
    </VerticalStackLayout>
</ContentPage>
