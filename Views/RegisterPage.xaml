<ContentPage
    x:Class="ArenaVirtual.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels"
    Title="Registrar"
    x:DataType="vm:RegisterViewModel">

    <VerticalStackLayout Padding="30" Spacing="15">
        <Button
            BackgroundColor="Transparent"
            Clicked="OnVoltarClicked"
            FontAttributes="Bold"
            HorizontalOptions="Start"
            Text="← Voltar"
            TextColor="OrangeRed" />
        <Entry Placeholder="Nome" Text="{Binding Nome}" />
        <Entry
            Keyboard="Email"
            Placeholder="Email"
            Text="{Binding Email}" />
        <Entry
            Completed="OnRegisterEnterPressed"
            IsPassword="True"
            Placeholder="Senha"
            Text="{Binding Senha}" />
        <Entry
            IsPassword="True"
            Placeholder="Confirmar Senha"
            Text="{Binding ConfirmarSenha}" />
        <Picker
            Title="Selecione o perfil"
            ItemsSource="{Binding PerfisDisponiveis}"
            SelectedItem="{Binding PerfilSelecionado}" />
        <Button Command="{Binding RegistrarCommand}" Text="Registrar" />
    </VerticalStackLayout>
</ContentPage>
