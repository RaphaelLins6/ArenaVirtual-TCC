<ContentView
    x:Class="ArenaVirtual.Views.Components.CampeonatoCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArenaVirtual.Views.Components"
    xmlns:model="clr-namespace:ArenaVirtual.Models"
    xmlns:views="clr-namespace:ArenaVirtual.Views"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels"
    BackgroundColor="Transparent">

    <Border
        Margin="0,0,0,10"
        Padding="10"
        Stroke="Gray"
        StrokeShape="RoundRectangle 8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Ícone de Favorito no canto superior direito  -->
            <Label
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,4,0"
                FontSize="20"
                HorizontalOptions="End"
                Text="{Binding EhFavorito, Converter={StaticResource FavoritoIconConverter}}"
                TextColor="Orange"
                VerticalOptions="Start">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BindingContext.FavoritarCommand, Source={RelativeSource AncestorType={x:Type views:HomePage}}}" CommandParameter="{Binding .}" />
                </Label.GestureRecognizers>
            </Label>

            <Image
                Grid.RowSpan="2"
                Grid.Column="0"
                Aspect="AspectFill"
                HeightRequest="60"
                HorizontalOptions="Center"
                Source="{Binding LogoUrl}"
                WidthRequest="60" />

            <StackLayout
                Grid.Row="1"
                Grid.Column="1"
                HorizontalOptions="Center"
                Spacing="6"
                VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="{Binding Nome}"
                    TextColor="White" />
                <Label
                    FontSize="14"
                    Text="{Binding Local}"
                    TextColor="White" />
                <Label
                    FontSize="12"
                    Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}"
                    TextColor="White" />
                <Label
                    FontSize="12"
                    Text="{Binding DataFim, StringFormat='Fim: {0:dd/MM/yyyy}'}"
                    TextColor="White" />

                <HorizontalStackLayout Margin="0,8,0,0" Spacing="10">
                    <Button
                        BackgroundColor="OrangeRed"
                        Command="{Binding BindingContext.ParticiparCommand, Source={RelativeSource AncestorType={x:Type views:HomePage}}}"
                        CommandParameter="{Binding .}"
                        Style="{StaticResource BotaoPrincipal}"
                        Text="Participar"
                        TextColor="White" />

                    <Button
                        BackgroundColor="Transparent"
                        BorderColor="OrangeRed"
                        BorderWidth="1"
                        Command="{Binding BindingContext.VerCampeonatoCommand, Source={RelativeSource AncestorType={x:Type views:HomePage}}}"
                        CommandParameter="{Binding .}"
                        Style="{StaticResource BotaoPrincipal}"
                        Text="Ver Campeonato"
                        TextColor="OrangeRed" />
                </HorizontalStackLayout>
            </StackLayout>
        </Grid>
    </Border>
</ContentView>
