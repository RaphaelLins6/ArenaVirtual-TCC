<ContentPage
    x:Class="ArenaVirtual.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels"
    Title="Campeonatos"
    x:DataType="vm:HomeViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ZeroToTrueConverter x:Key="ZeroToTrueConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <StackLayout>
        <CollectionView ItemsSource="{Binding Campeonatos}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Margin="10"
                        Padding="10"
                        BackgroundColor="Black"
                        CornerRadius="12">
                        <VerticalStackLayout>
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="{Binding Nome}"
                                TextColor="White" />
                            <Label
                                FontSize="14"
                                Text="{Binding Descricao}"
                                TextColor="Gray" />
                            <Button
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=FavoritarCommand}"
                                CommandParameter="{Binding .}"
                                Text="Favoritar" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="Nenhum campeonato encontrado."
               IsVisible="{Binding Campeonatos.Count, Converter={StaticResource ZeroToTrueConverter}}"
               HorizontalOptions="Center" VerticalOptions="Center" />
    </StackLayout>
</ContentPage>
