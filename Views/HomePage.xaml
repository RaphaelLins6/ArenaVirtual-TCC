<ContentPage
    x:Class="ArenaVirtual.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArenaVirtual.Views.Components"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels"
    x:DataType="vm:HomeViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <StackLayout Padding="20" Spacing="24">

            <Label
                FontAttributes="Bold"
                FontSize="28"
                HorizontalOptions="Center"
                Text="Campeonatos"
                TextColor="OrangeRed" />

            <StackLayout>
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="Favoritos"
                    TextColor="OrangeRed" />

                <CollectionView ItemsSource="{Binding CampeonatosFavoritos}">
                    <CollectionView.EmptyView>
                        <Label
                            HorizontalOptions="Center"
                            Text="Nenhum campeonato favoritado."
                            TextColor="White"
                            VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <local:CampeonatoCard />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <StackLayout>
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="Todos os Campeonatos"
                    TextColor="OrangeRed" />

                <CollectionView ItemsSource="{Binding Campeonatos}">
                    <CollectionView.EmptyView>
                        <Label
                            HorizontalOptions="Center"
                            Text="Nenhum campeonato encontrado."
                            TextColor="White"
                            VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <local:CampeonatoCard />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>
