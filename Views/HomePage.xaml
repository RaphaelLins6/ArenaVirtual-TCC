<ContentPage
    x:Class="ArenaVirtual.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels"
    Title="Campeonatos"
    x:DataType="vm:HomeViewModel">

    <ScrollView>
        <StackLayout Padding="20" Spacing="24">

            <Label Text="Campeonatos"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="OrangeRed" />

            <StackLayout>
                <Label Text="Favoritos"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="OrangeRed" />

                <CollectionView ItemsSource="{Binding CampeonatosFavoritos}">
                    <CollectionView.EmptyView>
                        <Label Text="Nenhum campeonato favoritado."
                           HorizontalOptions="Center"
                           TextColor="White"
                           VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <local:CampeonatoCard />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <StackLayout>
                <Label Text="Todos os Campeonatos"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="OrangeRed" />

                <CollectionView ItemsSource="{Binding Campeonatos}">
                    <CollectionView.EmptyView>
                        <Label Text="Nenhum campeonato encontrado."
                           HorizontalOptions="Center"
                           TextColor="White"
                           VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <local:CampeonatoCard />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>
