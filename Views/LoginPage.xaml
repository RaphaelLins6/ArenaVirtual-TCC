<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ArenaVirtual.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels"
    Title="Login"
    x:DataType="vm:LoginViewModel">
    <VerticalStackLayout Padding="30" Spacing="25">
        <Entry
            Keyboard="Email"
            Placeholder="Email"
            Text="{Binding Email}" />
        <Entry
            IsPassword="True"
            Placeholder="Senha"
            Text="{Binding Senha}" />
        <Button
            Clicked="OnEntrarClicked"
            Command="{Binding LoginCommand}"
            Style="{StaticResource BotaoPrincipal}"
            Text="Entrar" />
        <Label HorizontalOptions="Center" Text="Não tem uma conta?" />
        <Label
            HorizontalOptions="Center"
            Text="Registre-se"
            TextColor="OrangeRed">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding RegisterCommand}" />
            </Label.GestureRecognizers>
        </Label>
    </VerticalStackLayout>
</ContentPage>