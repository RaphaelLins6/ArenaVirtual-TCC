<ContentPage
    x:Class="ArenaVirtual.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArenaVirtual.ViewModels"
    Title="Login"
    x:DataType="vm:LoginViewModel">

    <VerticalStackLayout Padding="30" Spacing="25">
        <Entry
            Keyboard="Email"
            Placeholder="Email"
            Text="{Binding Email}" />
        <Entry
            Completed="Senha_Completed"
            IsPassword="True"
            Placeholder="Senha"
            ReturnType="Go"
            Text="{Binding Senha}" />
        <Button
            Command="{Binding LoginCommand}"
            Style="{StaticResource BotaoPrincipal}"
            Text="Entrar" />
        <Label
            HorizontalOptions="Center"
            Text="Não tem uma conta?"
            TextColor="White" />
        <Label HorizontalOptions="Center" Text="Registre-se">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding IrParaRegistroCommand}" />
            </Label.GestureRecognizers>
        </Label>
    </VerticalStackLayout>
</ContentPage>
