<ContentPage
    x:Class="ArenaVirtual.Views.PerfilPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:ArenaVirtual.ViewModels;assembly=ArenaVirtual"
    Title="Meu Perfil"
    x:DataType="viewmodels:PerfilViewModel">

    <ContentPage.Resources>
        <Style x:Key="CardFrameStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#333333}" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="10" />
                </Setter.Value>
            </Setter>
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{StaticResource Gray200}" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
    </ContentPage.Resources>

    <Grid
        Padding="20"
        ColumnDefinitions="*"
        RowDefinitions="Auto, Auto, *, Auto"
        RowSpacing="15">

        <VerticalStackLayout
            Grid.Row="1"
            HorizontalOptions="Center"
            Spacing="10">
            <Border
                HeightRequest="150"
                Stroke="{StaticResource Primary}"
                StrokeShape="RoundRectangle 75"
                StrokeThickness="1"
                WidthRequest="150">
                <Image
                    x:Name="ImagemPerfil"
                    Aspect="AspectFill"
                    HorizontalOptions="Center"
                    Source="user_avatar_placeholder.png"
                    VerticalOptions="Center" />
            </Border>
            <Label
                FontAttributes="Bold"
                FontSize="22"
                HorizontalOptions="Center"
                Text="{Binding Saudacao}"
                TextColor="{StaticResource Primary}" />
            <Label
                FontSize="18"
                HorizontalOptions="Center"
                Text="{Binding NomeUsuario}"
                TextColor="{AppThemeBinding Light=Black,
                                            Dark=White}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Margin="0,20,0,0" Spacing="15">

                <!--  Cards comuns  -->
                <Border Style="{StaticResource CardFrameStyle}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                        <Image
                            HeightRequest="24"
                            Source="email_icon.png"
                            VerticalOptions="Center"
                            WidthRequest="24" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label
                                FontSize="14"
                                Text="E-mail"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding EmailUsuario}"
                                TextColor="{AppThemeBinding Light=Black,
                                                            Dark=White}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardFrameStyle}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                        <Image
                            HeightRequest="24"
                            Source="profile_type_icon.png"
                            VerticalOptions="Center"
                            WidthRequest="24" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label
                                FontSize="14"
                                Text="Tipo de Perfil"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding TipoPerfilUsuario}"
                                TextColor="{AppThemeBinding Light=Black,
                                                            Dark=White}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardFrameStyle}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                        <Image
                            HeightRequest="24"
                            Source="location_icon.png"
                            VerticalOptions="Center"
                            WidthRequest="24" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label
                                FontSize="14"
                                Text="Localização"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding LocalizacaoUsuario}"
                                TextColor="{AppThemeBinding Light=Black,
                                                            Dark=White}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  Seção Atleta  -->
                <VerticalStackLayout IsVisible="{Binding IsAtleta}" Spacing="15">
                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="icon_birthday.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Data de Nascimento"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding DataNascimentoUsuarioFormatado}"
                                    TextColor="{AppThemeBinding Light=Black,
                                                                Dark=White}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="icon_gender.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Gênero"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding GeneroUsuario}"
                                    TextColor="{AppThemeBinding Light=Black,
                                                                Dark=White}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="icon_weight.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Peso"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding PesoUsuario}"
                                    TextColor="{AppThemeBinding Light=Black,
                                                                Dark=White}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="icon_height.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Altura"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding AlturaUsuario}"
                                    TextColor="{AppThemeBinding Light=Black,
                                                                Dark=White}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="phone_icon.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Número de Telefone"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding TelefoneUsuario}"
                                    TextColor="{AppThemeBinding Light=Black,
                                                                Dark=White}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="social_icon.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Rede Social"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding LinkRedeSocialUsuario}"
                                    TextColor="{AppThemeBinding Light=Black,
                                                                Dark=White}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!--  Seção Organizador  -->
                <VerticalStackLayout IsVisible="{Binding IsOrganizador}" Spacing="15">
                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="icon_company.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Nome da Empresa"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding NomeEmpresaUsuario}"
                                    TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="icon_cnpj.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="CNPJ"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding CnpjUsuario}"
                                    TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="phone_icon.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Número de Telefone"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding TelefoneUsuario}"
                                    TextColor="{AppThemeBinding Light=Black,
                                                                Dark=White}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="social_icon.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Rede Social"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding LinkRedeSocialUsuario}"
                                    TextColor="{AppThemeBinding Light=Black,
                                                                Dark=White}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!--  Seção Árbitro  -->
                <VerticalStackLayout IsVisible="{Binding IsArbitro}" Spacing="15">
                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="icon_birthday.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Data de Nascimento"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding DataNascimentoUsuarioFormatado}"
                                    TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="icon_gender.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Gênero"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding GeneroUsuario}"
                                    TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="phone_icon.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Número de Telefone"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding TelefoneUsuario}"
                                    TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="social_icon.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Rede Social"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding LinkRedeSocialUsuario}"
                                    TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!--  Seção Patrocinador  -->
                <VerticalStackLayout IsVisible="{Binding IsPatrocinador}" Spacing="15">
                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="icon_company.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Nome da Empresa"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding NomeEmpresaUsuario}"
                                    TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="icon_cnpj.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="CNPJ"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding CnpjUsuario}"
                                    TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="phone_icon.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Número de Telefone"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding TelefoneUsuario}"
                                    TextColor="{AppThemeBinding Light=Black,
                                                                Dark=White}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardFrameStyle}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Image
                                HeightRequest="24"
                                Source="social_icon.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontSize="14"
                                    Text="Rede Social"
                                    TextColor="{StaticResource Gray500}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding LinkRedeSocialUsuario}"
                                    TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout
            Grid.Row="3"
            Margin="0,20,0,0"
            Spacing="10">
            <Button
                Clicked="AlterarImagem_Clicked"
                Style="{StaticResource BotaoPrincipal}"
                Text="Alterar Imagem" />
            <Button
                Command="{Binding EditarPerfilCommand}"
                Style="{StaticResource BotaoPrincipal}"
                Text="Editar Perfil" />
            <Button
                Command="{Binding AlterarSenhaCommand}"
                Style="{StaticResource BotaoPrincipal}"
                Text="Trocar Senha" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
