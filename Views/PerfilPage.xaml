<ContentPage
    x:Class="ArenaVirtual.Views.PerfilPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:ArenaVirtual.ViewModels;assembly=ArenaVirtual"
    Title="Meu Perfil">

    <Grid
        Padding="20"
        ColumnDefinitions="*"
        RowDefinitions="Auto, Auto, *, Auto"
        RowSpacing="15">

        <Label
            Grid.Row="0"
            Margin="0,0,0,10"
            FontAttributes="Bold"
            FontSize="28"
            HorizontalOptions="Center"
            Text="Meu Perfil"
            TextColor="{AppThemeBinding Light=Black,
                                        Dark=White}" />

        <VerticalStackLayout
            Grid.Row="1"
            HorizontalOptions="Center"
            Spacing="10">
            <Frame
                Padding="0"
                BorderColor="{StaticResource Primary}"
                CornerRadius="75"
                HasShadow="False"
                HeightRequest="150"
                IsClippedToBounds="True"
                WidthRequest="150">
                <Image
                    x:Name="UserImage"
                    Aspect="AspectFill"
                    HorizontalOptions="Center"
                    Source="user_avatar_placeholder.png"
                    VerticalOptions="Center" />
            </Frame>
            <Label
                FontAttributes="Bold"
                FontSize="22"
                HorizontalOptions="Center"
                Text="{Binding Saudacao}"
                TextColor="{StaticResource Primary}" />
            <Label
                FontSize="18"
                HorizontalOptions="Center"
                Text="{Binding NomeUsuario}"
                TextColor="{AppThemeBinding Light=Black,
                                            Dark=White}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Margin="0,20,0,0" Spacing="15">

                <Frame Style="{StaticResource CardFrameStyle}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                        <Image
                            HeightRequest="24"
                            Source="email_icon.png"
                            VerticalOptions="Center"
                            WidthRequest="24" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label
                                FontSize="14"
                                Text="E-mail"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding EmailUsuario}"
                                TextColor="{AppThemeBinding Light=Black,
                                                            Dark=White}" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource CardFrameStyle}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                        <Image
                            HeightRequest="24"
                            Source="profile_type_icon.png"
                            VerticalOptions="Center"
                            WidthRequest="24" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label
                                FontSize="14"
                                Text="Tipo de Perfil"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding TipoPerfilUsuario}"
                                TextColor="{AppThemeBinding Light=Black,
                                                            Dark=White}" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource CardFrameStyle}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                        <Image
                            HeightRequest="24"
                            Source="location_icon.png"
                            VerticalOptions="Center"
                            WidthRequest="24" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label
                                FontSize="14"
                                Text="Localização"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding LocalizacaoUsuario}"
                                TextColor="{AppThemeBinding Light=Black,
                                                            Dark=White}" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout
            Grid.Row="3"
            Margin="0,20,0,0"
            Spacing="10">
            <Button
                Command="{Binding EditarPerfilCommand}"
                Style="{StaticResource PrimaryButton}"
                Text="Editar Perfil" />
            <Button
                Command="{Binding AlterarSenhaCommand}"
                Style="{StaticResource SecondaryButton}"
                Text="Alterar Senha" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>