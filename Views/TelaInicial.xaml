<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArenaVirtuall.Views.TelaInicial"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="TelaInicial">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="20">

            <!--  Grid para Campeonatos Favoritos  -->
            <Grid>
                <Label
                    FontAttributes="Bold"
                    FontSize="24"
                    HorizontalOptions="Start"
                    Text="Campeonatos Favoritos" />
                <!--  Adicione aqui os elementos para exibir os campeonatos favoritos  -->
            </Grid>

            <!--  Grid para Barra de Pesquisa  -->
            <Grid FlexLayout.AlignSelf="Center">
                <Entry Placeholder="Buscar campeonatos..." />
                <Button HorizontalOptions="End" Text="Pesquisar" />
            </Grid>

            <!--  Grid para Campeonatos por Popularidade  -->
            <Grid>
                <Label
                    FontAttributes="Bold"
                    FontSize="24"
                    HorizontalOptions="Start"
                    Text="Campeonatos Populares" />
                <!--  Adicione aqui os elementos para exibir os campeonatos populares  -->
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
