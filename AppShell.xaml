<Shell
    x:Class="ArenaVirtuall.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ArenaVirtuall.Views"
    Shell.FlyoutBehavior="Flyout">

    <!--  Menu lateral  -->
    <FlyoutItem Title="Início" Icon="home.png">
        <ShellContent Title="Início" ContentTemplate="{DataTemplate views:TelaInicial}" />
    </FlyoutItem>

    <FlyoutItem Title="Criar Campeonato" Icon="add.png">
        <ShellContent Title="Criar Campeonato" ContentTemplate="{DataTemplate views:CriarCampeonato}" />
    </FlyoutItem>

    <FlyoutItem Title="Atleta" Icon="user.png">
        <ShellContent Title="Atleta" ContentTemplate="{DataTemplate views:PaginaAtleta}" />
    </FlyoutItem>

</Shell>
